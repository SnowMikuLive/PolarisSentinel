{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Inference": {
    "ModelPath": "../ml/artifacts/rf_model.onnx",
    "AnomalyModelPath": "../ml/artifacts/if_model.onnx"
  },
  "PolicySettings": {
    "FlowIdleTimeoutMilliseconds": 120000,
    "PreFilterMinPackets": 3,
    "RfConfidenceThreshold": 0.6,
    "AutoBlockConfidenceThreshold": 0.8,
    "IfAnomalyThreshold": -0.150806,
    "BlockDurationMinutes": 60,
    "DecisionCooldownSeconds": 60,
    "Allowlist": []
  }
}
