@{
    ViewData["Title"] = "AI Inference Engine";
}

<div class="container-fluid">
    <h2 class="text-primary">AI Inference Engine</h2>
    <p>Model status and real-time inference results</p>

    @* Model status card *@
    <div class="card shadow-sm border-primary mb-4">
        <div class="card-header bg-primary text-white">
            Model Status
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <span class="fw-bold">Model:</span>
                    <span id="modelName">Loading...</span>
                </div>
                <div class="col-md-4">
                    <span class="fw-bold">Classes:</span>
                    <span id="modelClasses">-</span>
                </div>

                <div class="col-md-4">
                    @* Split RF and IF thresholds into two lines to avoid unit confusion *@
                    <span class="fw-bold">Thresholds:</span>
                    <div class="small">
                        <span class="text-primary">[RF]</span>
                        Alert≥<span id="alertThreshold">-</span>,
                        Block≥<span id="blockThreshold">-</span>
                    </div>
                    <div class="small">
                        <span class="text-primary">[IF]</span>
                        Anomal Score &lt; <span id="anomalyThreshold">-</span>
                        <span class="text-muted">(Monitor only)</span>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>

    @* Four stat card for adapting the new policy action *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-flows">0</div>
                    <div class="text-muted">Flows analysed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-success" id="c-benign">0</div>
                    <div class="text-muted">Benign</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-monitor">0</div>
                    <div class="text-muted">Monitor</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-block">0</div>
                    <div class="text-muted">Block</div>
                </div>
            </div>
        </div>
    </div>

    @* Inference result table *@
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Live Inference Results
        </div>
        <div class="card-body p-0">
            @* the style will change when mouse hover on the top.  *@
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Time</th>
                        <th>Source IP</th>
                        <th>Target IP</th>
                        <th>Target Port</th>
                        <th>Attack Type</th>
                        <th>Confidence</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="inferenceBody">
                    @* the information will add by SignalR automatically *@
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts{
    @* SignalR client library *@
    <script src="~/lib/signalR/signalr.min.js"></script>
    <script>
        //Fetch model info
        fetch('/api/demo/info')
        .then(r=>r.json())
        .then(info=>{
            document.getElementById('modelName').textContent='rf_model.onnx';
            document.getElementById('modelClasses').textContent=info.classes.join(', ');
            document.getElementById('alertThreshold').textContent=Math.round(info.rfThreshold*100)+'%';
            document.getElementById('blockThreshold').textContent=Math.round(info.blockThreshold*100)+'%';
            // add if logic to detect anomaly status
            if (info.anomalyDetection)
            {
                document.getElementById('anomalyThreshold').textContent=info.anomalyThreshold.toFixed(3);
            }else{
                document.getElementById('anomalyThreshold').textContent='N/A';
            }
        })
        .catch(()=>{
            document.getElementById('modelName').textContent='Unavailable';
        });

        //SessionStorage cache
        const CACHE_KEY='aiEngine_decisions';
        const MAX_CACHED=50;

        //Load the cache from the sessionStorage
        function loadCache(){
            try{
                // Read previous saved data from sessionStorage
                const raw=sessionStorage.getItem(CACHE_KEY);
                // If the data is read (raw means not null). then use JSON.parse to parse it into an object. otherwise, return the default empty data.
                return raw ? JSON.parse(raw):[];
                }catch{
                    //If any error occur during or parsing, return the default empty data directly.
                    return [];
                }
        }

        //Save catch to sessionStorage
        function saveCache(decisions){
            try{
                sessionStorage.setItem(
                    CACHE_KEY,JSON.stringify(decisions.slice(0,MAX_CACHED)));
            }catch{/*Ignore the storage quota errors*/}
        }

        //Restore from cache
        let cachedDecisions=loadCache();

        //Count for new policy actions
        const counts={flows:0,benign:0,monitor:0,block:0};

        function renderCounts()
        {
            document.getElementById('c-flows').textContent=counts.flows;
            document.getElementById('c-benign').textContent=counts.benign;
            document.getElementById('c-monitor').textContent=counts.monitor;
            document.getElementById('c-block').textContent=counts.block;
        }

        //Restore and counts from cache
        function restoreCountsFromCache(){
            counts.flows=cachedDecisions.length;
            counts.benign=cachedDecisions.filter(d=>d.attackType==='Benign').length;
            counts.monitor=cachedDecisions.filter(d=>d.action==='Monitor').length;
            counts.block=cachedDecisions.filter(d=>d.action==='Block').length;
            renderCounts();
        }

        //Add inference result row   
        function addInferenceRow(d)
        {
            const body=document.getElementById('inferenceBody');
            const row=body.insertRow(0);
            //put color on the policy action
            row.className=d.action==='Block'?'table-danger':
            //'' means still be defalt table style
                          d.action==='Monitor'?'table-warning':'';

            //Generate badge based on action to distinguish the IF and RF
            const badge=d.action==='Block'?'<span class="badge bg-danger">BLOCK</span>':
                        (d.action==='Monitor' && d.attackType==='Unknown_Anomaly') ? '<span class="badge bg-warning text-dark">IF MONITOR</span>':
                        d.action==='Monitor'?'<span class="badge bg-warning text-dark">RF MONITOR</span>':'<span class="badge bg-secondary">IGNORE</span>';

            const scoreCell=d.attackType==='Unknown_Anomaly'?'<span class="text-muted small">N/A</span>': (d.confidence*100).toFixed(1) + '%';

            row.innerHTML=
                `<td>${d.decidedAt}</td>`+
                `<td>${d.sourceIp}</td>`+
                `<td>${d.destinationIp}</td>`+
                `<td>${d.destinationPort}</td>`+
                `<td>${d.attackType}</td>`+
                `<td>${scoreCell}</td>`+
                `<td>${badge}</td>`;

            while(body.rows.length>MAX_CACHED)body.deleteRow(MAX_CACHED);
        }

        //add Restore table and counts on load
        for(let i=cachedDecisions.length -1;i>=0;i--){
            addInferenceRow(cachedDecisions[i]);
        }
        restoreCountsFromCache();

        // Connect to TrafficHub
        const connection=new signalR.HubConnectionBuilder()
            .withUrl('/trafficHub')
            .withAutomaticReconnect()
            .build();

        //Listen for policy decision events
        connection.on('ReceivePolicyDecision',(d)=>{counts.flows++;
            if(d.attackType==='Benign'){
                counts.benign++;
            }else{
                if(d.action==='Block')counts.block++;
                else if(d.action==='Monitor')counts.monitor++;
            }

            //Prepend to cache and persist
            cachedDecisions.unshift(d);
            if(cachedDecisions.length>MAX_CACHED) cachedDecisions.pop();
            saveCache(cachedDecisions);


            addInferenceRow(d);
            renderCounts();
        });

        //Start the connection
        connection.start().catch(err=>console.error(err.toString()));
            
    </script>
}