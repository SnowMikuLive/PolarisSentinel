@* Razor view for the Dashboard page in an ASP.NET Core MVC application. It sets the page title to "Dashboard" and displays a container with a heading, a description, and a card showing live traffic information. The live traffic value is dynamically populated from the ViewBag. *@
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2>Dashboard</h2>
    <p>System Overview & Real-time Status</p>

    @* Hidden element by demo-dashboard.js for model info, will be used in the future for model version display and model update notification. *@
    <span id="model-info" class="d-none"></span>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-flows" >0</div>
                    <div class="text-muted">Flows analysed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-success" id="c-benign" >0</div>
                    <div class="text-muted">Benign</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-alerts">0</div>
                    <div class="text-muted">Alerts (conf &ge; 0.6)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-blocks">0</div>
                    @* show the confidence *@
                    <div class="text-muted">Block-eligible (conf &ge; 0.8)</div>
                </div>
            </div>
        </div>
    </div>
               

    <div class="row mt-4">
        @* <div class="col-md-8"> *@
        @*Put the live traffic trend chart in the middle temporarily, and the AI inference results on the right. The chart will be updated in real-time using SignalR.*@
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    Live Traffic Trend
                </div>
                <div class="card-body">

                    <canvas id="trafficChart" height="200"></canvas>
                </div>   
            </div>
        </div>

        @* <div class="col-md-4"> *@
            @* <div class="card shadow-sm border-secondary"> *@
                @*<div class="card-header bg-secondary text-white">
                    AI Inference Results
                </div>
                <div class="card-body">
                    <p class="text-muted">No data yet</p>
                    @*the AI inference results will be displayed here in the future. *@
                @* </div> *@
            @* </div> *@
        @* </div> *@

    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    Live Detections
                </div>
                <div class="card-body p-0">
                    <p class="mb-2">
                        <span class="badge bg-light text-dark border">DoS <span id="c-dos">0</span></span>
                        <span class="badge bg-light text-dark border">PortScan <span id="c-portscan">0</span></span>
                        <span class="badge bg-light text-dark border">BruteForce <span id="c-bruteforce">0</span></span>
                        <span id="conn-state" class="badge bg-secondary">connecting…</span>
                    </p>

                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Source IP</th>
                                <th>Target port</th>
                                <th>Detected type</th>
                                <th>Confidence</th>
                                <th>Action tier</th>
                            </tr>
                        </thead>
                        <tbody id="det-body"></tbody>
                    </table>
                    @*the system status will be displayed here in the future. *@
                </div>
            </div>
        </div>
      </div>  
</div>

@section Scripts {
    @* Chart.js CDN (temporary) *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* SignalR client library *@
    <script src="~/lib/signalr/signalr.min.js"></script>
    @*demo dashboard logic*@
    <script src="~/js/demo-dashboard.js" asp-append-version="true"></script>
    
    @* Live traffic chart *@
    <script>
        // Create empty chart 
        //ctx is the context of the canvas element
        const ctx = document.getElementById('trafficChart').getContext('2d'); 
        //Chart with line type
        const trafficChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Packets per second',
                    data: [], 
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(40, 100, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                scales: {
                    y: {beginAtZero: true}
                }
            }
        });

        // SignalR connection to receive live traffic data
        const TrafficConnection = new signalR.HubConnectionBuilder()
            .withUrl("/trafficHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        TrafficConnection.on("ReceiveLiveTrafficSummary", (summary) => {            
            // Update the chart with new data
            const now=new Date().toLocaleTimeString();
            trafficChart.data.labels.push(now);
            trafficChart.data.datasets[0].data.push(summary.packetsPerSecond);

            if(trafficChart.data.labels.length>20)
            {
                trafficChart.data.labels.shift();
                trafficChart.data.datasets[0].data.shift();
            }

            trafficChart.update();
        });
        //Connect the server. if failed, then send messages to console. prevent crash.
        TrafficConnection.start().catch(err=>console.error(err.toString()));
    </script>
}