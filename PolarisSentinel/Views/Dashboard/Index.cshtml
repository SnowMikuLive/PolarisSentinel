@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="text-primary">Dashboard</h2>
    <p>System Overview & Real-time Status</p>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@ViewBag.LiveTraffic</div>
                    <div class="text-muted">Live Traffic</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning">@ViewBag.AlertsCount</div>
                    <div class="text-muted">Alerts</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-success">@ViewBag.AiAccuracy</div>
                    <div class="text-muted">AI Accuracy</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-secondary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@ViewBag.ActiveRules</div>
                    <div class="text-muted">Active Rules</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    Live Traffic Trend
                </div>
                <div class="card-body">
                    <canvas id="trafficChart" height="200"></canvas>
                </div>   
            </div>
        </div>

        @* it will add soon *@
        @* <div class="col-md-4"> *@
            @* <div class="card shadow-sm border-secondary"> *@
                @*<div class="card-header bg-secondary text-white">
                    AI Inference Results
                </div>
                <div class="card-body">
                    <p class="text-muted">No data yet</p>
                    @*the AI inference results will be displayed here in the future. *@
                @* </div> *@
            @* </div> *@
        @* </div> *@

    </div>

    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    Live Detections
                </div>
                <div class="card-body p-0">
                    <p class="mb-2">
                        <span class="badge bg-light text-dark border">DoS <span id="c-dos">0</span></span>
                        <span class="badge bg-light text-dark border">PortScan <span id="c-portscan">0</span></span>
                        <span class="badge bg-light text-dark border">BruteForce <span id="c-bruteforce">0</span></span>
                        <span id="conn-state" class="badge bg-secondary">connecting…</span>
                    </p>

                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Source IP</th>
                                <th>Target port</th>
                                <th>Detected type</th>
                                <th>Confidence</th>
                                <th>Action tier</th>
                            </tr>
                        </thead>
                        <tbody id="det-body"></tbody>
                    </table>
                    @*the system status will be displayed here in the future. *@
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const ctx = document.getElementById('trafficChart').getContext('2d');
        const trafficChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Packets per second',
                    data: [],
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(40, 100, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        const trafficConnection = new signalR.HubConnectionBuilder()
            .withUrl("/trafficHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        trafficConnection.on("ReceiveLiveTrafficSummary", (summary) => {
            const now = new Date().toLocaleTimeString();
            trafficChart.data.labels.push(now);
            trafficChart.data.datasets[0].data.push(summary.packetsPerSecond);

            if (trafficChart.data.labels.length > 20) {
                trafficChart.data.labels.shift();
                trafficChart.data.datasets[0].data.shift();
            }

            trafficChart.update();
        });

        trafficConnection.start().catch(err => console.error(err.toString()));
    </script>
}
