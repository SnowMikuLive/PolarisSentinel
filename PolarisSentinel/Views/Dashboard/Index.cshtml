@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="text-primary">Dashboard</h2>
    <p>System Overview & Real-time Status</p>

    @* Four cards on the top now show the overview of system, all driven by SignalR *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-live-traffic">0</div>
                    <div class="text-muted">Live Traffic (Kpps)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-info shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-info" id="c-active-flows">0</div>
                    <div class="text-muted">Active Flows</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-alerts">0</div>
                    <div class="text-muted">Alerts (Cumulative)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-blocks">0</div>
                    <div class="text-muted">Blocks (Cumulative)</div>
                </div>
            </div>
        </div>
    </div>

    @* Left: live traffic trend chart *@
    <div class="row mt-4 g-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Live Traffic Trend
                </div>
                <div class="card-body">
                    <canvas id="trafficChart" height="220"></canvas>
                </div>   
            </div>
        </div>

        @* Right: AI Inference Results (latest 8 policy decisions) *@
        <div class="col-md-6"> 
             <div class="card shadow-sm border-primary h-100"> 
                <div class="card-header bg-primary text-white">
                    AI Inference Results
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        @* id="aiResultBody" filled by SignalR *@
                        <tbody id="aiResultBody">
                        </tbody>
                    </table>
                </div> 
             </div>
         </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const MAX_ROWS=8;
        const ctx = document.getElementById('trafficChart').getContext('2d');
        const trafficChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Packets per second',
                    data: [],
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(40, 100, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive:true,
                maintainAspectRatio:false,
                scales: {
                    y: { 
                        beginAtZero: true,
                        grid:{color:'rgba(37,99,235,0.1)'},
                        ticks:{color:'#2563EB'}
                        },
                    x: { 
                        grid:{color:'rgba(37,99,235,0.1)'},
                        ticks:{color:'#2563EB'}
                        }
                }
            }
        });

        //local counters for SignalR updates
        let cumulativeAlerts=0;
        let cumulativeBlocks=0;

        //add: Fetch state from API on load
        fetch('/api/detections/state')
            .then(r=>r.json())
            .then(state=>{
                //Restore cumulative counters
                cumulativeAlerts=state.monitor+state.block;
                cumulativeBlocks=state.block;
                document.getElementById('c-alerts').textContent=cumulativeAlerts;
                document.getElementById('c-blocks').textContent=cumulativeBlocks;


                //Restore AI results table (non-benign only, newest first, max 8)
                const nonBenign=state.recent;//.filter(d=>d.attackType !=='Benign');

                for (let i=Math.min(nonBenign.length, MAX_ROWS)-1;i>=0;i--)
                {
                    addAiResultRow(nonBenign[i]);
                }
        })
        .catch(err=>console.error('Failed to fetch state',err));

        // Connect the SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/trafficHub")
            .withAutomaticReconnect()
            .build();
       
        // Receive live traffic summary: update chart + two live cards
        connection.on("ReceiveLiveTrafficSummary", (summary) => {
            const now = new Date().toLocaleTimeString();
            trafficChart.data.labels.push(now);
            trafficChart.data.datasets[0].data.push(summary.packetsPerSecond);

            if (trafficChart.data.labels.length > 20) {
                trafficChart.data.labels.shift();
                trafficChart.data.datasets[0].data.shift();
            }

            trafficChart.update();

            // Live Traffic card show Kpps
            document.getElementById('c-live-traffic').textContent=(summary.packetsPerSecond/1000).toFixed(1);
            
            // Active Flows card
            document.getElementById('c-active-flows').textContent=summary.activeFlowCount;
        });

        //Receive policy decisions:accumulate Alerts/Blocks + add to AI results
        connection.on('ReceivePolicyDecision',(d)=>{
            if(d.attackType==='Benign')return;

            cumulativeAlerts++;
            if(d.action==='Block')cumulativeBlocks++;

            document.getElementById('c-alerts').textContent=cumulativeAlerts;
            document.getElementById('c-blocks').textContent=cumulativeBlocks;

            addAiResultRow(d);
        });

        // AI results function shows
        function addAiResultRow(d)
        {
            const body=document.getElementById('aiResultBody');
            const row=body.insertRow(0);

            //color depende on the policy action
            row.className=d.action==='Block'?'table-danger':
                          d.action==='Monitor'?'table-warning':'';

            // the budge which can distinguish the IF and RF
            const badge=d.action==='Block'?
                            '<span class="badge bg-danger">BLOCK</span>':
                            (d.action==='Monitor' && d.attackType==='Unknown_Anomaly') ?
                            '<span class="badge bg-warning text-dark">IF</span>':
                            '<span class="badge bg-warning text-dark">RF</span>';

            row.innerHTML=
                    `<td>${d.decidedAt}</td>`+
                    `<td>${d.attackType}</td>`+
                    `<td>${badge}</td>`;

            //Keep max 8 rows
            while (body.rows.length>MAX_ROWS)body.deleteRow(MAX_ROWS);
        }

        connection.start().catch(err => console.error(err.toString()));
    </script>
}