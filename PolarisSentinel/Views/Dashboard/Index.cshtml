@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="text-primary">Dashboard</h2>
    <p>System Overview & Real-time Status</p>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@ViewBag.LiveTraffic</div>
                    <div class="text-muted">Live Traffic</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning">@ViewBag.AlertsCount</div>
                    <div class="text-muted">Alerts</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-success">@ViewBag.AiAccuracy</div>
                    <div class="text-muted">AI Accuracy</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-secondary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold">@ViewBag.ActiveRules</div>
                    <div class="text-muted">Active Rules</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-10 offset-md-1">
            <div class="card shadow-sm border-primary">
                <div class="card-header bg-primary text-white">
                    Live Traffic Trend
                </div>
                <div class="card-body">
                    <canvas id="trafficChart" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const ctx = document.getElementById('trafficChart').getContext('2d');
        const trafficChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Packets per second',
                    data: [],
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(40, 100, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                scales: {
                    y: { beginAtZero: true }
                }
            }
        });

        const trafficConnection = new signalR.HubConnectionBuilder()
            .withUrl("/trafficHub")
            .configureLogging(signalR.LogLevel.Information)
            .build();

        trafficConnection.on("ReceiveLiveTrafficSummary", (summary) => {
            const now = new Date().toLocaleTimeString();
            trafficChart.data.labels.push(now);
            trafficChart.data.datasets[0].data.push(summary.packetsPerSecond);

            if (trafficChart.data.labels.length > 20) {
                trafficChart.data.labels.shift();
                trafficChart.data.datasets[0].data.shift();
            }

            trafficChart.update();
        });

        trafficConnection.start().catch(err => console.error(err.toString()));
    </script>
}
