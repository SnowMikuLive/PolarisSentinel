@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Delete Rule";
}

<div class="container-fluid">
    <h2 class="text-danger mb-3">Delete Rule</h2>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            Confirm Deletion
        </div>
        <div class="card-body">
            <p class="mb-3">Are you sure you want to delete this rule?</p>

            <dl class="row">
                <dt class="col-sm-3">Remote Address</dt>
                <dd class="col-sm-9">@Model.RemoteAddress</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">@Model.Action</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
