@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Create Rule";
    var policies = ViewBag.Policies as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var statuses = ViewBag.Statuses as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Create Rule</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            New Rule
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="RemoteAddress" class="form-label">Remote Address (IP)</label>
                        <input asp-for="RemoteAddress" class="form-control" placeholder="e.g. 203.0.113.10" />
                        <span asp-validation-for="RemoteAddress" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                        <span asp-validation-for="Action" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select" asp-items="statuses"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PolicyId" class="form-label">Policy (optional)</label>
                        <select asp-for="PolicyId" class="form-select" asp-items="policies">
                            <option value="">-- None (manual rule) --</option>
                        </select>
                        <span asp-validation-for="PolicyId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AlertId" class="form-label">Alert Id (optional)</label>
                        <input asp-for="AlertId" class="form-control" placeholder="Leave empty for manual rule" />
                        <span asp-validation-for="AlertId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpiresAt" class="form-label">Expires At (optional)</label>
                        <input asp-for="ExpiresAt" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ExpiresAt" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
