@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Rule Details";
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Rule Details</h2>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            @Model.RemoteAddress
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Remote Address</dt>
                <dd class="col-sm-9">@Model.RemoteAddress</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Action</span></dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">@Model.Status</dd>

                <dt class="col-sm-3">Policy Id</dt>
                <dd class="col-sm-9">@(Model.PolicyId?.ToString() ?? "-")</dd>

                <dt class="col-sm-3">Alert Id</dt>
                <dd class="col-sm-9">@(Model.AlertId?.ToString() ?? "-")</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss") UTC</dd>

                <dt class="col-sm-3">Expires At</dt>
                <dd class="col-sm-9">@(Model.ExpiresAt?.ToString("yyyy-MM-dd HH:mm:ss") ?? "Never")</dd>
            </dl>
        </div>
    </div>

    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
