@model IReadOnlyList<PolarisSentinel.Core.Models.Alert>
@{
    ViewData["Title"] = "Alerts";
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Alerts</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Detection Alerts
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Detected</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Protocol</th>
                        <th>Attack Type</th>
                        <th>Severity</th>
                        <th>Confidence</th>
                        <th>Origin</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">No alerts yet.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>@item.SourceIp:@item.SourcePort</td>
                            <td>@item.DestinationIp:@item.DestinationPort</td>
                            <td>@item.Protocol</td>
                            <td class="fw-bold">@item.AttackType</td>
                            <td>
                                @if (item.Severity == null)
                                {
                                    <span class="text-muted">-</span>
                                }
                                else
                                {
                                    var badge = item.Severity switch
                                    {
                                        PolarisSentinel.Core.Enums.Severity.Critical => "bg-danger",
                                        PolarisSentinel.Core.Enums.Severity.High => "bg-warning text-dark",
                                        PolarisSentinel.Core.Enums.Severity.Medium => "bg-info text-dark",
                                        PolarisSentinel.Core.Enums.Severity.Low => "bg-secondary",
                                        _ => "bg-light text-dark"
                                    };
                                    <span class="badge @badge">@item.Severity</span>
                                }
                            </td>
                            <td>@item.Confidence.ToString("0.000")</td>
                            <td><span class="badge bg-secondary">@item.Source</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
