@model IReadOnlyList<PolarisSentinel.Core.Models.ModelEvaluationResult>?
@using PolarisSentinel.Core.Constants
@using PolarisSentinel.Core.Models
@{
    ViewData["Title"] = "Charts";
    var results = Model as IReadOnlyList<ModelEvaluationResult> ?? Array.Empty<ModelEvaluationResult>();
    var combinations = ViewBag.Combinations as IReadOnlyList<PolarisSentinel.Core.Enums.ModelCombination>
        ?? Array.Empty<PolarisSentinel.Core.Enums.ModelCombination>();
    var rows = ViewBag.Rows as IReadOnlyList<LabeledFlow> ?? Array.Empty<LabeledFlow>();
    int page = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 20;
    int datasetCount = ViewBag.DatasetCount ?? 0;
    string? datasetName = ViewBag.DatasetName;
    int startIndex = (page - 1) * pageSize;
}

<div class="container-fluid">
    <h2 class="text-primary">Charts</h2>
    <p class="text-muted">
        Test a model combination on a real flow and compare all five combinations on the loaded dataset.
    </p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-body">
            <form asp-action="Upload" method="post" enctype="multipart/form-data" class="row align-items-end">
                <div class="col-md-8">
                    <label class="form-label">Labeled CSV</label>
                    <input type="file" name="dataset" accept=".csv" class="form-control" />
                    <div id="fileHint" class="small mt-1"></div>
                    <div class="text-muted small mt-1">
                        Upload a CSV with the 20 ML feature columns plus a <code>label</code> column.
                        @if (datasetCount > 0)
                        {
                            <span>Loaded: <strong>@datasetName</strong> (@datasetCount row(s)).</span>
                        }
                        else
                        {
                            <span>No dataset loaded yet.</span>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-outline-secondary">Load Dataset</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-7">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Model Test
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Model Combination</label>
                            <select id="modelCombination" class="form-select">
                                @foreach (var item in combinations)
                                {
                                    <option value="@item">@ModelCombinations.DisplayName(item)</option>
                                }
                            </select>
                            <div class="text-muted small mt-1">Change the live model on the Dashboard.</div>
                        </div>
                    </div>

                    <h6 class="text-secondary mb-2">Combination Logic</h6>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm table-bordered align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Model Combination</th>
                                    <th>Logic</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr><td>Random Forest Only</td><td>Classifies the flow with the Random Forest model only.</td></tr>
                                <tr><td>Isolation Forest Only</td><td>Scores the flow when the Isolation Forest judges it an anomaly, otherwise benign.</td></tr>
                                <tr><td>Isolation Forest -&gt; Random Forest</td><td>The Isolation Forest gates first, then the Random Forest names the attack type.</td></tr>
                                <tr><td>Random Forest -&gt; Isolation Forest</td><td>The Random Forest wins on a high-confidence attack, otherwise it falls back to the Isolation Forest.</td></tr>
                                <tr><td>Parallel Random Forest + Isolation Forest</td><td>A known Random Forest attack wins first, otherwise the Isolation Forest anomaly verdict is used.</td></tr>
                            </tbody>
                        </table>
                    </div>

                    <h6 class="text-secondary mb-2">Test Rows</h6>
                    @if (rows.Count == 0)
                    {
                        <div class="alert alert-info mb-0">Load a dataset to select a test row.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Label</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < rows.Count; i++)
                                    {
                                        int rowIndex = startIndex + i;
                                        var row = rows[i];
                                        <tr>
                                            <td>@(rowIndex + 1)</td>
                                            <td>
                                                @if (row.IsMalicious)
                                                {
                                                    <span class="badge bg-danger">Malicious</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Benign</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <button type="button" class="btn btn-sm btn-primary run-row" data-index="@rowIndex">Run</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        @if (datasetCount > pageSize)
                        {
                            int totalPages = (datasetCount + pageSize - 1) / pageSize;
                            int window = 2;
                            int firstShown = Math.Max(1, page - window);
                            int lastShown = Math.Min(totalPages, page + window);

                            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2">
                                <nav aria-label="Test row pages" style="max-width: 100%; min-width: 0;">
                                    <ul class="pagination pagination-sm mb-0 flex-wrap">
                                        @if (page > 1)
                                        {
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1" aria-label="First">&laquo;</a></li>
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" aria-label="Previous">&lsaquo;</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item disabled"><span class="page-link" aria-hidden="true">&laquo;</span></li>
                                            <li class="page-item disabled"><span class="page-link" aria-hidden="true">&lsaquo;</span></li>
                                        }

                                        @if (firstShown > 1)
                                        {
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="1">1</a></li>
                                            if (firstShown > 2)
                                            {
                                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                            }
                                        }

                                        @for (int p = firstShown; p <= lastShown; p++)
                                        {
                                            <li class="page-item @(p == page ? "active" : "")">
                                                <a class="page-link" asp-action="Index" asp-route-page="@p">@p</a>
                                            </li>
                                        }

                                        @if (lastShown < totalPages)
                                        {
                                            if (lastShown < totalPages - 1)
                                            {
                                                <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                            }
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@totalPages">@totalPages</a></li>
                                        }

                                        @if (page < totalPages)
                                        {
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" aria-label="Next">&rsaquo;</a></li>
                                            <li class="page-item"><a class="page-link" asp-action="Index" asp-route-page="@totalPages" aria-label="Last">&raquo;</a></li>
                                        }
                                        else
                                        {
                                            <li class="page-item disabled"><span class="page-link" aria-hidden="true">&rsaquo;</span></li>
                                            <li class="page-item disabled"><span class="page-link" aria-hidden="true">&raquo;</span></li>
                                        }
                                    </ul>
                                </nav>
                                <span class="text-muted small text-nowrap">Page @(page) of @(totalPages)</span>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Result
                </div>
                <div class="card-body">
                    <div id="testError" class="alert alert-danger d-none"></div>
                    <dl class="row mb-0">
                        <dt class="col-sm-6">Selected Model Combination</dt>
                        <dd class="col-sm-6" id="r-combination">-</dd>

                        <dt class="col-sm-6">Attack Type</dt>
                        <dd class="col-sm-6" id="r-attackType">-</dd>

                        <dt class="col-sm-6">Confidence Score</dt>
                        <dd class="col-sm-6" id="r-confidence">-</dd>

                        <dt class="col-sm-6">Detection Source</dt>
                        <dd class="col-sm-6" id="r-source">-</dd>

                        <dt class="col-sm-6">Dataset Label</dt>
                        <dd class="col-sm-6" id="r-expected">-</dd>
                    </dl>

                    <div id="featureBlock" class="d-none mt-3">
                        <h6 class="text-secondary mb-2">Selected Row - 20 Input Features</h6>
                        <div class="table-responsive" style="max-height: 340px; overflow-y: auto;">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 2.5rem;">#</th>
                                        <th>Feature</th>
                                        <th class="text-end">Value</th>
                                    </tr>
                                </thead>
                                <tbody id="featureBody"></tbody>
                            </table>
                        </div>
                        <div id="featureNote" class="text-muted small mt-1"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            Model Comparison
        </div>
        <div class="card-body">
            <form asp-action="Evaluate" method="post">
                <button type="submit" class="btn btn-primary" @(datasetCount == 0 ? "disabled" : "")>Evaluate Loaded Dataset</button>
                <span class="text-muted small ms-2">
                    @if (datasetCount > 0)
                    {
                        <span>Runs all five combinations on @datasetName (@datasetCount row(s)).</span>
                    }
                    else
                    {
                        <span>Load a dataset first.</span>
                    }
                </span>
            </form>
        </div>
    </div>

    @if (results.Count > 0)
    {
        <div class="card shadow-sm border-primary mb-3">
            <div class="card-header bg-primary text-white">
                Model Comparison
                <span class="float-end small">@ViewBag.FileName - @ViewBag.RowCount row(s)</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Model Combination</th>
                                <th class="text-end">Accuracy</th>
                                <th class="text-end">Precision</th>
                                <th class="text-end">Recall</th>
                                <th class="text-end">F1-score</th>
                                <th class="text-end">FPR</th>
                                <th class="text-end">FNR</th>
                                <th class="text-end">TP</th>
                                <th class="text-end">TN</th>
                                <th class="text-end">FP</th>
                                <th class="text-end">FN</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in results)
                            {
                                var m = row.Metrics;
                                <tr>
                                    <td>@ModelCombinations.DisplayName(row.Combination)</td>
                                    <td class="text-end">@Pct(m.Accuracy)</td>
                                    <td class="text-end">@Pct(m.Precision)</td>
                                    <td class="text-end">@Pct(m.Recall)</td>
                                    <td class="text-end">@Pct(m.F1Score)</td>
                                    <td class="text-end">@Pct(m.FalsePositiveRate)</td>
                                    <td class="text-end">@Pct(m.FalseNegativeRate)</td>
                                    <td class="text-end">@m.TruePositives</td>
                                    <td class="text-end">@m.TrueNegatives</td>
                                    <td class="text-end">@m.FalsePositives</td>
                                    <td class="text-end">@m.FalseNegatives</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-primary mb-3">
            <div class="card-header bg-primary text-white">
                Metrics by Model Combination
            </div>
            <div class="card-body">

                <div style="position: relative; height: 440px;">
                    <canvas id="metricsChart"></canvas>
                </div>
            </div>
        </div>

        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white">Metric Formulas</div>
            <div class="card-body small">
                <div><strong>Accuracy (Overall Correctness)</strong> = (TP + TN) / (TP + TN + FP + FN). The proportion of all flows that were classified correctly.</div>
                <div><strong>Precision (Positive Predictive Value)</strong> = TP / (TP + FP). The proportion of flows flagged as attacks that were actually attacks.</div>
                <div><strong>Recall (Sensitivity / True Positive Rate)</strong> = TP / (TP + FN). The proportion of actual attacks that were correctly detected.</div>
                <div><strong>F1-score (Harmonic Mean of Precision and Recall)</strong> = 2 * (Precision * Recall) / (Precision + Recall). A single score that balances precision and recall.</div>
                <div><strong>False Positive Rate (FPR)</strong> = FP / (FP + TN). The proportion of benign flows that were wrongly flagged as attacks.</div>
                <div><strong>False Negative Rate (FNR)</strong> = FN / (FN + TP). The proportion of actual attacks that were missed.</div>
            </div>
        </div>
    }
</div>

@functions {

    static string Pct(double? value) => value is null ? "N/A" : (value.Value * 100).ToString("0.00") + "%";
}

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        if (typeof Chart === 'undefined') {
            window.Chart = function () { return { data: { datasets: [{ data: [] }, { data: [] }] }, options: {}, update: function () { } }; };
            window.Chart.register = function () { };
            window.ChartDataLabels = {};
        }

        const datasetInput = document.querySelector('input[name="dataset"]');
        const fileHint = document.getElementById('fileHint');
        if (datasetInput && fileHint) {
            const maxBytes = 10 * 1024 * 1024;
            datasetInput.addEventListener('change', function () {
                if (!datasetInput.files || datasetInput.files.length === 0) { fileHint.textContent = ''; return; }
                const file = datasetInput.files[0];
                if (file.size > maxBytes) {
                    fileHint.className = 'small mt-1 text-danger';
                    fileHint.textContent = 'This file is ' + (file.size / 1048576).toFixed(1)
                        + ' MB, above the 10 MB limit. Choose a smaller sample or split the CSV.';
                    datasetInput.value = '';
                    return;
                }
                fileHint.className = 'small mt-1 text-success';
                fileHint.textContent = file.name + ' (' + (file.size / 1048576).toFixed(2) + ' MB) is ready to load.';
            });
        }

        document.querySelectorAll('.run-row').forEach(function (button) {
            button.addEventListener('click', function () {
                const body = {
                    modelCombination: document.getElementById('modelCombination').value,
                    rowIndex: parseInt(button.dataset.index, 10)
                };

                fetch('/Charts/Test', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementById('requestVerificationToken').value
                    },
                    body: JSON.stringify(body)
                })
                    .then(async r => {

                        const text = await r.text();
                        let data = null;
                        if (text) {
                            try { data = JSON.parse(text); } catch (_) { data = null; }
                        }

                        if (!r.ok) {
                            throw new Error((data && data.error) || ('Test failed (HTTP ' + r.status + ').'));
                        }

                        if (!data) {
                            throw new Error('The server returned an empty response.');
                        }

                        return data;
                    })
                    .then(showResult)
                    .catch(showError);
            });
        });

        function showResult(data) {
            document.getElementById('testError').classList.add('d-none');
            document.getElementById('r-combination').textContent = data.combination;
            document.getElementById('r-attackType').textContent = data.attackType;
            document.getElementById('r-confidence').textContent = data.confidenceScore == null ? 'N/A' : data.confidenceScore.toFixed(3);
            document.getElementById('r-source').textContent = data.detectionSource;
            document.getElementById('r-expected').innerHTML = data.expectedMalicious
                ? '<span class="badge bg-danger">Malicious</span>'
                : '<span class="badge bg-success">Benign</span>';

            renderFeatures(data);
        }

        function renderFeatures(data) {
            const block = document.getElementById('featureBlock');
            const body = document.getElementById('featureBody');
            const values = data.features || [];
            const names = data.featureNames || [];

            if (values.length === 0) {
                block.classList.add('d-none');
                return;
            }

            let html = '';
            for (let i = 0; i < values.length; i++) {
                html += '<tr><td class="text-muted">' + i + '</td>'
                    + '<td>' + (names[i] || ('feature_' + i)) + '</td>'
                    + '<td class="text-end font-monospace">' + String(values[i]) + '</td></tr>';
            }

            body.innerHTML = html;
            document.getElementById('featureNote').textContent =
                'Row ID ' + data.rowId + ' \u00b7 ' + values.length + ' values, in the order the model receives them';
            block.classList.remove('d-none');
        }

        function showError(err) {
            const box = document.getElementById('testError');
            box.textContent = err.message;
            box.classList.remove('d-none');
            document.getElementById('featureBlock').classList.add('d-none');
        }

        @if (results.Count > 0)
        {
            <text>
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(results.Select(r => ModelCombinations.DisplayName(r.Combination))));
            const accuracy = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(results.Select(r => r.Metrics.Accuracy)));
            const precision = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(results.Select(r => r.Metrics.Precision)));
            const recall = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(results.Select(r => r.Metrics.Recall)));
            const f1 = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(results.Select(r => r.Metrics.F1Score)));

            const metricStyle = { borderWidth: 1, borderRadius: 4, maxBarThickness: 46 };
            const pct = function (value) { return (value * 100).toFixed(1) + '%'; };

            new Chart(document.getElementById('metricsChart').getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Accuracy', data: accuracy, backgroundColor: 'rgba(13,110,253,0.85)', borderColor: '#0d6efd', ...metricStyle },
                        { label: 'Precision', data: precision, backgroundColor: 'rgba(25,135,84,0.85)', borderColor: '#198754', ...metricStyle },
                        { label: 'Recall', data: recall, backgroundColor: 'rgba(255,193,7,0.9)', borderColor: '#ffc107', ...metricStyle },
                        { label: 'F1-score', data: f1, backgroundColor: 'rgba(220,53,69,0.85)', borderColor: '#dc3545', ...metricStyle }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { top: 8, right: 8 } },
                    plugins: {
                        legend: {
                            position: 'top',
                            labels: { usePointStyle: true, boxWidth: 10, padding: 16 }
                        },
                        title: {
                            display: true,
                            text: 'Accuracy, Precision, Recall and F1-score by combination',
                            color: '#6c757d',
                            font: { size: 13, weight: 'normal' },
                            padding: { bottom: 10 }
                        },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    const v = ctx.parsed.y;
                                    return ctx.dataset.label + ': ' + (v == null ? 'N/A' : pct(v));
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 1,
                            grid: { color: 'rgba(0,0,0,0.06)' },
                            ticks: {

                                stepSize: 0.1,
                                callback: function (value) { return (value * 100).toFixed(0) + '%'; }
                            },
                            title: { display: true, text: 'Score' }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { autoSkip: false, maxRotation: 30, minRotation: 0 }
                        }
                    }
                }
            });
            </text>
        }
    </script>
}
