<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolarisSentinel</title>

    @* Bootstrap CSS *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Custom CSS *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <div class="d-flex justify-content-center align-items-center flex-grow-1 py-5">
        @RenderBody()
    </div>

    <footer class="text-center pb-3">
        @* color and font can be changed *@
        <span class="text-muted" style="font-size:11px;color:#BCC6D4 !important;">v1.0.0</span>
    </footer>

    @* jQuery *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* Bootstrap JS *@
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @* Toastr CSS *@
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css"/>
    @* Toastr JS *@
    <script src="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>

    @* Success notification *@
    @if (TempData["success"] != null)
    {
        <script type="text/javascript">
            toastr.success('@TempData["success"]');
        </script>
    }
    @* Error notification *@
    @if (TempData["error"] != null)
    {
        <script type="text/javascript">
                toastr.error('@TempData["error"]');
        </script>
    }

    @* Render script portions defined by the subview (if any) for page-specific scripts *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>