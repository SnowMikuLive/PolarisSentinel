<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PolarisSentinel</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <div class="d-flex justify-content-center align-items-center flex-grow-1 py-5">
        @RenderBody()
    </div>

    <footer class="text-center pb-3">
        <span class="text-muted" style="font-size:11px;color:#BCC6D4 !important;">v1.0.0</span>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" asp-append-version="true" />
    <script src="~/lib/toastr/toastr.min.js" asp-append-version="true"></script>

    @if (TempData["success"] != null)
    {
        <script type="text/javascript">
            toastr.success(@Json.Serialize(TempData["success"]));
        </script>
    }
    @if (TempData["error"] != null)
    {
        <script type="text/javascript">
                toastr.error(@Json.Serialize(TempData["error"]));
        </script>
    }


    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>