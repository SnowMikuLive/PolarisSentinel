@model IReadOnlyList<PolarisSentinel.Core.Models.Alert>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Inference Results";
}

<div class="container-fluid">
    <h2 class="text-primary">Inference Results</h2>
    <p class="text-muted">AI inference results that produced an alert. Benign flows are not alerted.</p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }
    @if (TempData["error"] != null)
    {
        <div class="alert alert-danger">@TempData["error"]</div>
    }

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Alerts
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-nowrap">ID</th>
                            <th class="text-nowrap">Created</th>
                            <th class="text-nowrap">Detection Source</th>
                            <th class="text-nowrap">Source</th>
                            <th class="text-nowrap">Destination</th>
                            <th class="text-nowrap">Attack Type</th>
                            <th class="text-nowrap">Confidence</th>
                            <th class="text-nowrap">Description</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No alerts yet.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@TimeFormat.Format(item.CreatedAt)</td>
                                <td><span class="badge bg-primary">@item.DetectionSource</span></td>
                                <td>@item.SourceIp:@item.SourcePort</td>
                                <td>@item.DestinationIp:@item.DestinationPort</td>
                                <td class="fw-bold">@item.AttackType</td>
                                <td>@(item.ConfidenceScore?.ToString("0.000") ?? "N/A")</td>
                                <td class="small">@(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count alert(s)
        </div>
    </div>
</div>
