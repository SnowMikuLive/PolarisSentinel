@model IReadOnlyList<PolarisSentinel.Core.Models.Alert>
@inject PolarisSentinel.Web.Service.SettingsService Settings
@{
    ViewData["Title"] = "Inference Results";
}

<div class="container-fluid">
    <h2 class="text-primary">Inference Results</h2>
    <p>Model status, real-time inference results and persisted alerts</p>

    @* Model status card *@
    <div class="card shadow-sm border-primary mb-4">
        <div class="card-header bg-primary text-white">
            Model Status
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <span class="fw-bold">Model:</span>
                    <span id="modelName">Loading...</span>
                </div>
                <div class="col-md-4">
                    <span class="fw-bold">Classes:</span>
                    <span id="modelClasses">-</span>
                </div>

                <div class="col-md-4">
                    @* Split RF and IF thresholds into two lines to avoid unit confusion *@
                    <span class="fw-bold">Thresholds:</span>
                    <div class="small">
                        <span class="text-primary">[RF]</span>
                        Alert≥<span id="alertThreshold">-</span>,
                        Block≥<span id="blockThreshold">-</span>
                    </div>
                    <div class="small">
                        <span class="text-primary">[IF]</span>
                        Anomal Score &lt; <span id="anomalyThreshold">-</span>
                        <span class="text-muted">(Monitor only)</span>
                    </div>
                    
                </div>
            </div>
        </div>
    </div>

    @* Four stat card for adapting the new policy action *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-flows">0</div>
                    <div class="text-muted">Flows analysed</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-success shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-success" id="c-benign">0</div>
                    <div class="text-muted">Benign</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-monitor">0</div>
                    <div class="text-muted">Monitor</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-block">0</div>
                    <div class="text-muted">Block</div>
                </div>
            </div>
        </div>
    </div>

    @* Inference result table *@
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Live Inference Results
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
            @* the style will change when mouse hover on the top.  *@
            <table class="table table-sm table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="text-nowrap">Time</th>
                        <th class="text-nowrap">Source IP</th>
                        <th class="text-nowrap">Target IP</th>
                        <th class="text-nowrap">Target Port</th>
                        <th class="text-nowrap">Attack Type</th>
                        <th class="text-nowrap">Confidence</th>
                        <th class="text-nowrap">Action</th>
                    </tr>
                </thead>
                <tbody id="inferenceBody">
                    @* the information will add by SignalR automatically *@
                </tbody>
            </table>
            </div>
        </div>
    </div>

    @* Persisted alerts *@
    <div class="card shadow-sm border-primary mt-3">
        <div class="card-header bg-primary text-white">
            Alerts
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-nowrap">ID</th>
                            <th class="text-nowrap">Detected</th>
                            <th class="text-nowrap">Source</th>
                            <th class="text-nowrap">Destination</th>
                            <th class="text-nowrap">Attack Type</th>
                            <th class="text-nowrap">Severity</th>
                            <th class="text-nowrap">Confidence</th>
                            <th class="text-nowrap">Action</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">No alerts yet.</td>
                            </tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@Settings.Format(item.DetectedAt)</td>
                                <td>@item.SourceIp:@item.SourcePort</td>
                                <td>@item.DestinationIp:@item.DestinationPort</td>
                                <td class="fw-bold">@item.AttackType</td>
                                <td>
                                    @if (item.Severity == null)
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                    else
                                    {
                                        var badge = item.Severity switch
                                        {
                                            PolarisSentinel.Core.Enums.Severity.Critical => "bg-danger",
                                            PolarisSentinel.Core.Enums.Severity.High => "bg-warning text-dark",
                                            PolarisSentinel.Core.Enums.Severity.Medium => "bg-info text-dark",
                                            PolarisSentinel.Core.Enums.Severity.Low => "bg-secondary",
                                            _ => "bg-light text-dark"
                                        };
                                        <span class="badge @badge">@item.Severity</span>
                                    }
                                </td>
                                <td>@item.Confidence.ToString("0.000")</td>
                                <td><span class="badge bg-secondary">@item.Action</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    @* SignalR client library *@
    <script src="~/lib/signalR/signalr.min.js"></script>
    <script>
        const MAX_ROWS=50;

        //Fetch model info
        fetch('/api/demo/info')
        .then(r=>r.json())
        .then(info=>{
            document.getElementById('modelName').textContent='rf_model.onnx';
            document.getElementById('modelClasses').textContent=info.classes.join(', ');
            document.getElementById('alertThreshold').textContent=Math.round(info.rfThreshold*100)+'%';
            document.getElementById('blockThreshold').textContent=Math.round(info.blockThreshold*100)+'%';
            document.getElementById('anomalyThreshold').textContent=info.anomalyDetection?info.anomalyThreshold.toFixed(3):'N/A';
        })
        .catch(()=>{
            document.getElementById('modelName').textContent='Unavailable';
        });

        //add: Fetch state from API on load
        fetch('/api/detections/state')
            .then(r=>r.json())
            .then(state=>{
                //Restore four cards
                document.getElementById('c-flows').textContent=state.flows;
                document.getElementById('c-benign').textContent=state.benign;
                document.getElementById('c-monitor').textContent=state.monitor;
                document.getElementById('c-block').textContent=state.block;

                //Restore table (non-benign only, newest first, max 50)
                const nonBenign=state.recent;//.filter(d=>d.attackType !=='Benign');

                for (let i=Math.min(nonBenign.length, MAX_ROWS)-1;i>=0;i--)
                {
                    addInferenceRow(nonBenign[i]);
                }
        })
        .catch(err=>console.error('Failed to fetch state',err));

        // Connect to TrafficHub
        const connection=new signalR.HubConnectionBuilder()
            .withUrl('/trafficHub')
            .withAutomaticReconnect()
            .build();

        //Listen for policy decision events
        connection.on('ReceivePolicyDecision',(d)=>{
            const flowsEl=document.getElementById('c-flows');
            flowsEl.textContent=parseInt(flowsEl.textContent)+1;

            if(d.attackType==='Benign'){
                const benignEl=document.getElementById('c-benign');
                benignEl.textContent=parseInt(benignEl.textContent)+1;
                //addInferenceRow(d);
            }else{
                if(d.action==='Block'){
                    const blockEl=document.getElementById('c-block');
                    blockEl.textContent=parseInt(blockEl.textContent)+1;
                }
                else if(d.action==='Monitor'){
                    const monitorEl=document.getElementById('c-monitor');
                    monitorEl.textContent=parseInt(monitorEl.textContent)+1;
                }
                //Table shows non-benign only
                addInferenceRow(d);
            }

        });

        //Add inference result row   
        function addInferenceRow(d)
        {
            const body=document.getElementById('inferenceBody');
            const row=body.insertRow(0);
            //put color on the policy action
            row.className=d.action==='Block'?'table-danger':
            // means still be defalt table style
                          d.action==='Monitor'?'table-warning':'';

            //Generate badge based on action to distinguish the IF and RF
            const badge=d.action==='Block'?'<span class="badge bg-danger">BLOCK</span>':
                        (d.action==='Monitor' && d.attackType==='Unknown_Anomaly') ? '<span class="badge bg-warning text-dark">IF MONITOR</span>':
                        d.action==='Monitor'?'<span class="badge bg-warning text-dark">RF MONITOR</span>':'<span class="badge bg-secondary">IGNORE</span>';

            const scoreCell=d.attackType==='Unknown_Anomaly'?'<span class="text-muted small">N/A</span>': (d.confidence*100).toFixed(1) + '%';

            row.innerHTML=
                `<td>${d.decidedAt}</td>`+
                `<td>${d.sourceIp}</td>`+
                `<td>${d.destinationIp}</td>`+
                `<td>${d.destinationPort}</td>`+
                `<td>${d.attackType}</td>`+
                `<td>${scoreCell}</td>`+
                `<td>${badge}</td>`;

            while(body.rows.length>MAX_ROWS)body.deleteRow(MAX_ROWS);
        }

        //Start the connection
        connection.start().catch(err=>console.error(err.toString()));
            
    </script>
}