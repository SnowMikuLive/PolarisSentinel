@model PolarisSentinel.Core.Models.Alert
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Alert Details";
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Alert Details</h2>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            @Model.AttackType
        </div>
        <div class="card-body">
            <h5 class="mb-3">Network 5-Tuple</h5>
            <dl class="row">
                <dt class="col-sm-3">ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Source IP</dt>
                <dd class="col-sm-9">@Model.SourceIp</dd>

                <dt class="col-sm-3">Source Port</dt>
                <dd class="col-sm-9">@Model.SourcePort</dd>

                <dt class="col-sm-3">Destination IP</dt>
                <dd class="col-sm-9">@Model.DestinationIp</dd>

                <dt class="col-sm-3">Destination Port</dt>
                <dd class="col-sm-9">@Model.DestinationPort</dd>

                <dt class="col-sm-3">Protocol</dt>
                <dd class="col-sm-9">@Model.Protocol</dd>
            </dl>

            <h5 class="mb-3">Inference Result</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Attack Type</dt>
                <dd class="col-sm-9">@Model.AttackType</dd>

                <dt class="col-sm-3">Confidence</dt>
                <dd class="col-sm-9">@Model.Confidence.ToString("0.000")</dd>

                <dt class="col-sm-3">Detection Source</dt>
                <dd class="col-sm-9">@Model.Source</dd>

                <dt class="col-sm-3">Detected At</dt>
                <dd class="col-sm-9">@TimeFormat.Format(Model.DetectedAt)</dd>
            </dl>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>
