@model PolarisSentinel.Core.Models.Policy
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Policy Details";
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Policy Details</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            @Model.Id
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</dd>

                <dt class="col-sm-3">Detection Source</dt>
                <dd class="col-sm-9">@(Model.DetectionSource?.ToString() ?? "Any")</dd>

                <dt class="col-sm-3">Attack Type</dt>
                <dd class="col-sm-9">@(Model.AttackType ?? "Any")</dd>

                <dt class="col-sm-3">RF Threshold</dt>
                <dd class="col-sm-9">@(Model.RfThreshold?.ToString("0.00") ?? "Not checked")</dd>

                <dt class="col-sm-3">IF Threshold</dt>
                <dd class="col-sm-9">@(Model.IfThreshold?.ToString("0.00") ?? "Not checked")</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">@Model.Action</dd>

                <dt class="col-sm-3">Block Duration</dt>
                <dd class="col-sm-9">@Model.BlockDurationMinutes min</dd>

                <dt class="col-sm-3">Priority</dt>
                <dd class="col-sm-9">@Model.Priority</dd>

                <dt class="col-sm-3">Enabled</dt>
                <dd class="col-sm-9">@(Model.IsEnabled ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Owner</dt>
                <dd class="col-sm-9">@Model.UserId</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@TimeFormat.Format(Model.CreatedAt)</dd>

                <dt class="col-sm-3">Updated</dt>
                <dd class="col-sm-9">@TimeFormat.Format(Model.UpdatedAt)</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
        </div>
    </div>
</div>
