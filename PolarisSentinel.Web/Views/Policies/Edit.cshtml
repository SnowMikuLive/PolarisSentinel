@model PolarisSentinel.Core.Models.Policy
@{
    ViewData["Title"] = "Edit Policy";
    var detectionSources = ViewBag.DetectionSources as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var attackTypes = ViewBag.AttackTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList
        ?? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Enumerable.Empty<string>());
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Edit Policy</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            @Model.Id
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <h6 class="text-secondary mb-3">Policy</h6>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <input asp-for="Description" class="form-control" />
                    </div>
                </div>

                <h6 class="text-secondary mb-3">Conditions</h6>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="DetectionSource" class="form-label">Detection Source</label>
                        <select asp-for="DetectionSource" class="form-select">
                            <option value="">Any</option>
                            @foreach (var item in detectionSources)
                            {
                                <option value="@item.Value" selected="@(Model.DetectionSource?.ToString() == item.Value?.ToString())">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="AttackType" class="form-label">Attack Type</label>
                        <select asp-for="AttackType" class="form-select">
                            <option value="">Any</option>
                            @foreach (var item in attackTypes)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="RfThreshold" class="form-label">Random Forest Threshold</label>
                        <input asp-for="RfThreshold" class="form-control" type="number" step="0.01" min="0" max="1" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="IfThreshold" class="form-label">Isolation Forest Threshold</label>
                        <input asp-for="IfThreshold" class="form-control" type="number" step="0.01" min="0" max="1" />
                    </div>
                </div>

                <h6 class="text-secondary mb-3">Action</h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Action" class="form-label">Action</label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="BlockDurationMinutes" class="form-label">Block Duration (minutes)</label>
                        <input asp-for="BlockDurationMinutes" class="form-control" type="number" min="1" />
                        <span asp-validation-for="BlockDurationMinutes" class="text-danger"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Priority" class="form-label">Priority (0-100)</label>
                        <input asp-for="Priority" class="form-control" type="number" min="0" max="100" />
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="IsEnabled" class="form-check-input" type="checkbox" />
                    <label asp-for="IsEnabled" class="form-check-label">Enabled</label>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
