@model PolarisSentinel.Core.Models.Policy
@{
    ViewData["Title"] = "Edit Policy";
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var sources = ViewBag.DetectionSources as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Edit Policy</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            @Model.Name
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="Description" class="form-label">Description (optional)</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Optional notes about this policy"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DetectionSource" class="form-label">Detection Source</label>
                        <select asp-for="DetectionSource" class="form-select" asp-items="sources"></select>
                        <span asp-validation-for="DetectionSource" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                        <span asp-validation-for="Action" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="RfConfidenceThreshold" class="form-label">RF Confidence Threshold</label>
                        <input asp-for="RfConfidenceThreshold" class="form-control" type="number" step="0.01" min="0" max="1" />
                        <span asp-validation-for="RfConfidenceThreshold" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AutoBlockConfidenceThreshold" class="form-label">Auto Block Threshold</label>
                        <input asp-for="AutoBlockConfidenceThreshold" class="form-control" type="number" step="0.01" min="0" max="1" />
                        <span asp-validation-for="AutoBlockConfidenceThreshold" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="BlockDurationMinutes" class="form-label">Block Duration (minutes)</label>
                        <input asp-for="BlockDurationMinutes" class="form-control" type="number" min="1" />
                        <span asp-validation-for="BlockDurationMinutes" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DecisionCooldownSeconds" class="form-label">Decision Cooldown (seconds)</label>
                        <input asp-for="DecisionCooldownSeconds" class="form-control" type="number" min="0" />
                        <span asp-validation-for="DecisionCooldownSeconds" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3 d-flex align-items-center">
                        <div class="form-check mt-4">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label"></label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
