@model IReadOnlyList<PolarisSentinel.Core.Models.Policy>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Policies";
}

<div class="container-fluid">
    <h2 class="text-primary">Policies</h2>
    <p class="text-muted">Matching conditions and the firewall action applied to a matching alert.</p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <div class="d-flex gap-2 mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <form asp-action="RemoveAll" method="post" onsubmit="return confirm('Remove all policies? Linked rules keep their history but lose the policy link.');">
            <button type="submit" class="btn btn-outline-danger">Remove All</button>
        </form>
    </div>

    @* Uses GET so filter conditions appear in the URL and can be bookmarked/shared *@
    <form asp-action="Index" method="get" class="card shadow-sm border-primary mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label small text-muted mb-1">Search</label>
                    <input type="search" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                           placeholder="Name, attack type, detection source..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Sort</label>
                    <select name="sort" class="form-select form-select-sm">
                        <option value="priority" selected="@(ViewBag.Sort == "priority" || ViewBag.Sort == null)">Priority</option>
                        <option value="name" selected="@(ViewBag.Sort == "name")">Name</option>
                        <option value="action" selected="@(ViewBag.Sort == "action")">Action</option>
                        <option value="enabled" selected="@(ViewBag.Sort == "enabled")">Enabled</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
                </div>
            </div>
        </div>
    </form>

    <div class="card shadow-sm border-primary">
        <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Policy ID</th>
                        <th>Name</th>
                        <th>Detection Source</th>
                        <th>Attack Type</th>
                        <th>Thresholds</th>
                        <th>Priority</th>
                        <th>Action</th>
                        <th>Block Duration</th>
                        <th>Enabled</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <div>No policies match the current filters.</div>
                                <a asp-action="Create" class="btn btn-sm btn-primary mt-2">Create the first policy</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@item.Name</td>
                                <td><span class="badge bg-primary">@(item.DetectionSource?.ToString() ?? "Any")</span></td>
                                <td>@(item.AttackType ?? "Any")</td>
                                <td class="small">RF @(item.RfThreshold?.ToString("0.00") ?? "-") / IF @(item.IfThreshold?.ToString("0.00") ?? "-")</td>
                                <td>@item.Priority</td>
                                <td><span class="badge bg-danger">@item.Action</span></td>
                                <td>@item.BlockDurationMinutes min</td>
                                <td>
                                    @* Inline toggle: flip a policy on/off without opening the edit form. *@
                                    <form asp-action="Toggle" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit"
                                                class="badge @(item.IsEnabled ? "bg-success" : "bg-secondary") border-0"
                                                title="@(item.IsEnabled ? "Click to disable" : "Click to enable")">
                                            @(item.IsEnabled ? "Enabled" : "Disabled")
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count policy(ies)
            @if (Context.Request.Query.Count > 0)
            {
                <span class="ms-2 badge bg-info text-dark">Filtered</span>
            }
        </div>
    </div>
</div>
