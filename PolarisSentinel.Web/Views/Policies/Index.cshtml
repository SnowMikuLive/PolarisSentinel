@model IReadOnlyList<PolarisSentinel.Core.Models.Policy>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Policies";
}

<div class="container-fluid">
    <h2 class="text-primary">Policies</h2>
    <p class="text-muted">Detection thresholds and enforcement settings.</p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    @* changed Top bar:button left+search input right *@

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <input type="text" id="searchPolicy" class="form-control form-control-sm"
               placeholder="🔍 Search policies..." style="width:220px;"/>
    </div>

    <div class="card shadow-sm border-primary">
        <div class="card-body p-0">
            @* added: table-reponsive*@
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="text-nowrap">Policy ID</th>
                        <th class="text-nowrap">Enable</th>
                        <th class="text-nowrap">Detection Source</th>
                        <th class="text-nowrap">Match</th>
                        <th class="text-nowrap">RF Threshold</th>
                        <th class="text-nowrap">IF Threshold</th>
                        <th class="text-nowrap">Block Duration</th>
                        <th class="text-nowrap">Created</th>
                        <th class="text-nowrap">Updated</th>
                        <th class="text-nowrap text-end">Manage</th>
                    </tr>
                </thead>
                <tbody id="policyTableBody">
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-3">No policies.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            @* add:Build searchable string *@
                            var searchText = $"{item.Id} {item.DetectionSource} {item.MatchAttackTypes} {item.RfConfidenceThreshold} {item.IfConfidenceThreshold}".ToLowerInvariant();
                            <tr data-search="@(searchText)">
                            <td class="fw-bold text-nowrap">@item.Id</td>
                            <td class="text-nowrap">@(item.Enabled?"Yes":"No")</td>
                            <td class="text-nowrap">
                                <span class="badge bg-primary">@item.DetectionSource</span>
                            </td>
                            <td class="text-nowrap small">@DescribeMatch(item)</td>
                            <td class="text-nowrap">@(item.RfConfidenceThreshold?.ToString("0.00") ?? "-")</td>
                            <td class="text-nowrap">@(item.IfConfidenceThreshold?.ToString("0.00") ?? "-")</td>
                            <td class="text-nowrap">@item.BlockDurationMinutes min</td>
                            <td class="text-nowrap">@TimeFormat.Format(item.CreatedAt)</td>
                            <td class="text-nowrap">@TimeFormat.Format(item.UpdatedAt)</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                      }
                    }
                </tbody>
            </table>
            </div>
            
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count policy(ies)
        </div>
    </div>
</div>

@functions {
    // One-line summary of the alert match criteria; "Any" when nothing is constrained.
    static string DescribeMatch(PolarisSentinel.Core.Models.Policy policy)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(policy.MatchAttackTypes))
        {
            parts.Add(policy.MatchAttackTypes);
        }

        if (policy.MatchProtocol != 0)
        {
            parts.Add(ProtocolName(policy.MatchProtocol));
        }

        return parts.Count == 0 ? "Any" : string.Join(" / ", parts);
    }

    // Map an IP protocol number to a readable name.
    static string ProtocolName(byte protocol) => protocol switch
    {
        1 => "ICMP",
        6 => "TCP",
        17 => "UDP",
        0 => "Any",
        _ => protocol.ToString()
    };
}

@* add:Frontend search script *@
@section Scripts{
    <script>
        document.addEventListener('DOMContentLoaded',()=>
        {
            const searchInput=document.getElementById('searchPolicy');
            const tableBody=document.getElementById('policyTableBody');
            if(!searchInput||!tableBody) return;

            searchInput.addEventListener('input',()=>{
                const query=searchInput.value.trim().toLowerCase();
                tableBody.querySelectorAll('tr[data-search]').forEach(row=>{
                const match=!query||row.dataset.search.includes(query);
                row.style.display=match?'':'none';
                });
            });
        });
    </script>
}
