@model IReadOnlyList<PolarisSentinel.Core.Models.Policy>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Policies";
}

<div class="container-fluid">
    <h2 class="text-primary">Policies</h2>
    <p class="text-muted">Detection thresholds and enforcement settings.</p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </div>

    <div class="card shadow-sm border-primary">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Policy ID</th>
                        <th>Enabled</th>
                        <th>Detection Source</th>
                        <th>Match</th>
                        <th>RF Threshold</th>
                        <th>IF Threshold</th>
                        <th>Block Duration</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="text-center text-muted py-3">No policies.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@(item.Enabled ? "Yes" : "No")</td>
                                <td><span class="badge bg-primary">@item.DetectionSource</span></td>
                                <td class="small">@DescribeMatch(item)</td>
                                <td>@(item.RfConfidenceThreshold?.ToString("0.00") ?? "-")</td>
                                <td>@(item.IfConfidenceThreshold?.ToString("0.00") ?? "-")</td>
                                <td>@item.BlockDurationMinutes min</td>
                                <td>@TimeFormat.Format(item.CreatedAt)</td>
                                <td>@TimeFormat.Format(item.UpdatedAt)</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count policy(ies)
        </div>
    </div>
</div>

@functions {
    // One-line summary of the alert match criteria; "Any" when nothing is constrained.
    static string DescribeMatch(PolarisSentinel.Core.Models.Policy policy)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(policy.MatchAttackTypes))
        {
            parts.Add(policy.MatchAttackTypes);
        }

        if (policy.MatchProtocol != 0)
        {
            parts.Add(ProtocolName(policy.MatchProtocol));
        }

        return parts.Count == 0 ? "Any" : string.Join(" / ", parts);
    }

    // Map an IP protocol number to a readable name.
    static string ProtocolName(byte protocol) => protocol switch
    {
        1 => "ICMP",
        6 => "TCP",
        17 => "UDP",
        0 => "Any",
        _ => protocol.ToString()
    };
}
