@model PolarisSentinel.Core.Models.Policy
@{
    ViewData["Title"] = "Delete Policy";
}

<div class="container-fluid">
    <h2 class="text-danger mb-3">Delete Policy</h2>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            @Model.Id
        </div>
        <div class="card-body">
            <p>Delete policy <strong>@Model.Name</strong>? Existing rules keep their historical relationship to it.</p>
            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
