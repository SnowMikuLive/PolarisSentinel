@{
    ViewData["Title"] = "Traffic Monitor";
}

<div class="container-fluid">
    @* text-primary is the blue color in the default bootstrap 5 *@
    <h2 class="text-primary">Traffic Monitor</h2>
    <p>Real-time network traffic status</p>

    @* Capture status row *@
    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-success me-2">•</span>
        <span class="text-success me-3">Capturing</span>
        <span class="text-muted me-3">|</span>
        <span class="me-3">Packets/s:<span id="livePacketsPerSecond">0</span></span>
        <span class="text-muted me-3">|</span>
        <span class="me-3">Bytes/s:<span id="liveBytesPerSecond">0</span></span>
    </div>

    @* Network interface selector *@
    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            Network Interface
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-8">
                    <select id="deviceSelect" class="form-select" onchange="switchDevice()">
                        <option value="">Loading...</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" class="btn btn-outline-primary w-100" onclick="refreshDevices()">Refresh</button>
                </div>
            </div>
            <div class="text-muted small mt-2" id="deviceInfo"></div>
        </div>
    </div>

<div class="row">
    @* Protocol Distribution Pie Chart on left*@
    <div class="col-md-6">
        <div class="card shadow-sm border-primary h-100">
           <div class="card-header bg-primary text-white">
                 Protocol Distribution
           </div>
           <div class="card-body d-flex align-items-center justify-content-center">
               <canvas id="protocolChart" height="280"></canvas>
           </div>
        </div>
    </div>

        @* Traffic summary on right*@
        <div class="col-md-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="avgRate">0</div>
                            <div class="text-muted">Avg. Rate (pps)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="peakRate">0</div>
                            <div class="text-muted">Peak Rate (pps)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="totalData">0</div>
                            <div class="text-muted">Total Data</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="activeFlowsCard">0</div>
                            <div class="text-muted">Active Flows</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Chart.js CDN is temporary. It will be replaced with a local version later and run without internet *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
     @* Show the data strictly *@
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>
    @* Signalr client library *@
    <script src="~/lib/signalr/signalr.min.js"></script>

    <script>
        //Register datalabels plugin (required)
        Chart.register(ChartDataLabels);
        // Protocol distribution chart initialization
        const protocolCtx=document.getElementById('protocolChart').getContext('2d');
        const protocolChart=new Chart(protocolCtx,{
            type:'doughnut',
            data:{
                labels:['TCP','UDP','ICMP'],
                datasets:[{
                    data:[0,0,0],
                    backgroundColor:['#2463ED','#60A5FA','#ADD0F7'],
                    borderWidth:1
                }]
            },
            options:{
                //auto resize the chart to fit the container
                responsive:true,
                //auto maintain the aspect ratio of the chart
                maintainAspectRatio:false,
                plugins:{
                    legend:{
                        //display the legend at the bottom of the chart
                        position:'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                let value = Math.round(context.parsed || 0);
                                return label + ': ' + value + '%';
                            }
                        }
                    },
                    // Show the percentage
                    datalabels: {
                        color: '#fff',
                        font: {
                            weight: 'bold',
                            size: 12
                        },
                        //Format as integer percentage
                        formatter: (value) => {
                            return Math.round(value) + '%';
                        },
                        display: (context) => {
                            return context.dataset.data[context.dataIndex] > 0;
                        }
                    }
                }
            }
        });
           

        //calculate the average rate and peak rate per second
        let peakPps=0;
        let sumPps=0;
        let countPps=0;
        let totalBytes=0;

        //to connet to TrafiicHub using SignalR
        const connection=new signalR.HubConnectionBuilder().withUrl('/trafficHub').configureLogging(signalR.LogLevel.Information).build();
        connection.on('ReceiveLiveTrafficSummary',(summary)=>{

            //update the protocol chart
            protocolChart.data.datasets[0].data=[summary.tcpShare*100,summary.udpShare*100,summary.icmpShare*100];
            protocolChart.update();

            //update the traffic summary cards
            //Average rate
            sumPps+=summary.packetsPerSecond;
            countPps++;
            //toFiced(1): means leave only one decimal place
            document.getElementById('avgRate').innerText=(sumPps/countPps).toFixed(1);

            //Peak rate
            if(summary.packetsPerSecond>peakPps)
            {
                peakPps=summary.packetsPerSecond;
            }
            document.getElementById('peakRate').innerText=peakPps.toFixed(1);

            //Total data cumulative approximation
            totalBytes+=summary.bytesPerSecond;
            document.getElementById('totalData').innerText=(totalBytes/1024/1024).toFixed(2)+' MB';

            //active flows
            document.getElementById('activeFlowsCard').innerText=summary.activeFlowCount;
            document.getElementById('livePacketsPerSecond').innerText=summary.packetsPerSecond.toFixed(1);
            document.getElementById('liveBytesPerSecond').innerText=summary.bytesPerSecond.toFixed(1);

        });
            //Start connection
            connection.start().catch(err=>console.error(err.toString()));

        // ---- Network interface selector ----
        function refreshDevices()
        {
            fetch('/api/capture/devices')
                .then(r=>r.json())
                .then(data=>{
                    const select=document.getElementById('deviceSelect');
                    select.innerHTML='';
                    data.devices.forEach(d=>{
                        const opt=document.createElement('option');
                        opt.value=d.deviceName;
                        const wifiTag=d.isWifi?' [Wi-Fi]':'';
                        opt.textContent=d.displayName+wifiTag+(d.ipAddress?' ('+d.ipAddress+')':'');
                        if(d.isCurrent)opt.selected=true;
                        select.appendChild(opt);
                    });
                    updateDeviceInfo(data.current);
                })
                .catch(err=>console.error('Failed to load devices',err));
        }

        function updateDeviceInfo(current)
        {
            const info=document.getElementById('deviceInfo');
            info.textContent=current?'Capturing on: '+current:'No device selected';
        }

        function switchDevice()
        {
            const select=document.getElementById('deviceSelect');
            const deviceName=select.value;
            if(!deviceName)return;

            fetch('/api/capture/select',{
                method:'POST',
                headers:{'Content-Type':'application/json'},
                body:JSON.stringify({deviceName:deviceName})
            })
            .then(r=>{
                if(!r.ok)throw new Error('switch failed');
                return r.json();
            })
            .then(data=>{
                updateDeviceInfo(data.current);
                refreshDevices();
            })
            .catch(err=>{
                console.error(err);
                alert('Failed to switch device');
                refreshDevices();
            });
        }

        //load devices on page load
        refreshDevices();
    </script>
}