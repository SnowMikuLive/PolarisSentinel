@{
    ViewData["Title"] = "Traffic Monitor";
}

<div class="container-fluid">
    <h2 class="text-primary">Traffic Monitor</h2>
    <p>Real-time network traffic status</p>

    <div class="d-flex align-items-center mb-3">
        <span class="badge bg-success me-2">•</span>
        <span class="text-success me-3">Capturing</span>
        <span class="text-muted me-3">|</span>
        <span class="me-3">Packets/s:<span id="livePacketsPerSecond">0</span></span>
        <span class="text-muted me-3">|</span>
        <span class="me-3">Bytes/s:<span id="liveBytesPerSecond">0</span></span>
    </div>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            Network Interface
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-6">
                    <label for="deviceSelect" class="form-label">Capture Device</label>
                    <select id="deviceSelect" class="form-select"></select>
                </div>
                <div class="col-md-6">
                    <button type="button" id="setDevice" class="btn btn-primary">Set</button>
                    <button type="button" id="refreshDevices" class="btn btn-outline-primary">Refresh</button>
                    <span id="deviceStatus" class="ms-2 small"></span>
                </div>
            </div>
        </div>
    </div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm border-primary h-100">
           <div class="card-header bg-primary text-white">
                 Protocol Distribution
           </div>
           <div class="card-body d-flex align-items-center justify-content-center">
               <canvas id="protocolChart" height="280"></canvas>
           </div>
        </div>
    </div>

        <div class="col-md-6">
            <div class="row g-3">
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="avgRate">0</div>
                            <div class="text-muted">Avg. Rate (pps)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="peakRate">0</div>
                            <div class="text-muted">Peak Rate (pps)</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="totalData">0</div>
                            <div class="text-muted">Total Data</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="card text-center shadow-sm border-primary">
                        <div class="card-body">
                            <div class="fs-2 fw-bold" id="activeFlowsCard">0</div>
                            <div class="text-muted">Active Flows</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
   <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/chartjs-plugin-datalabels/chartjs-plugin-datalabels.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/polaris-hub.js"></script>

    <script>

        if (typeof Chart === 'undefined') {
            window.Chart = function () { return { data: { datasets: [{ data: [] }] }, options: {}, update: function () { } }; };
            window.Chart.register = function () { };
        }
        if (typeof ChartDataLabels === 'undefined') { window.ChartDataLabels = {}; }

        Chart.register(ChartDataLabels);

        const protocolCtx=document.getElementById('protocolChart').getContext('2d');
        const protocolChart=new Chart(protocolCtx,{
            type:'doughnut',
            data:{
                labels:['TCP','UDP','ICMP'],
                datasets:[{
                    data:[0,0,0],
                    backgroundColor:['#2463ED','#60A5FA','#ADD0F7'],
                    borderWidth:1
                }]
            },
            options:{

                responsive:true,

                maintainAspectRatio:false,
                plugins:{
                    legend:{

                        position:'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.label || '';
                                let value = Math.round(context.parsed || 0);
                                return label + ': ' + value + '%';
                            }
                        }
                    },

                    datalabels: {
                        color: '#fff',
                        font: {
                            weight: 'bold',
                            size: 12
                        },

                        formatter: (value) => {
                            return Math.round(value) + '%';
                        },
                        display: (context) => {
                            return context.dataset.data[context.dataIndex] > 0;
                        }
                    }
                }
            }
        });

        let peakPps=0;
        let sumPps=0;
        let countPps=0;
        let totalBytes=0;

        polarisHub.on('ReceiveLiveTrafficSummary',(summary)=>{

            protocolChart.data.datasets[0].data=[summary.tcpShare*100,summary.udpShare*100,summary.icmpShare*100];
            protocolChart.update();

            sumPps+=summary.packetsPerSecond;
            countPps++;

            document.getElementById('avgRate').innerText=(sumPps/countPps).toFixed(1);

            if(summary.packetsPerSecond>peakPps)
            {
                peakPps=summary.packetsPerSecond;
            }
            document.getElementById('peakRate').innerText=peakPps.toFixed(1);

            totalBytes+=summary.bytes;
            document.getElementById('totalData').innerText=(totalBytes/1024/1024).toFixed(2)+' MB';

            document.getElementById('activeFlowsCard').innerText=summary.activeFlowCount;
            document.getElementById('livePacketsPerSecond').innerText=summary.packetsPerSecond.toFixed(1);
            document.getElementById('liveBytesPerSecond').innerText=summary.bytesPerSecond.toFixed(1);

        });

            polarisHub.start();

        fetch('/api/detections/state')
            .then(r=>r.json())
            .then(state=>{
                document.getElementById('activeFlowsCard').innerText=state.capturedFlows||0;
            })
            .catch(err=>console.error('Failed to fetch traffic state',err));

        const deviceSelect=document.getElementById('deviceSelect');
        const deviceStatus=document.getElementById('deviceStatus');

        function setDeviceStatus(text,isError)
        {
            deviceStatus.textContent=text;
            deviceStatus.className='ms-2 small '+(isError?'text-danger':'text-success');
        }

        function loadDevices()
        {
            setDeviceStatus('Loading...',false);
            const previous=deviceSelect.value;
            fetch('/api/capture/devices')
                .then(r=>{
                    if(!r.ok)throw new Error('HTTP '+r.status);
                    return r.json();
                })
                .then(data=>{
                    const devices=data.devices||[];

                    if(devices.length===0&&deviceSelect.options.length>0)
                    {
                        setDeviceStatus('No capture devices reported; keeping previous list.',true);
                        return;
                    }
                    deviceSelect.innerHTML='';
                    let currentValue=null;
                    let defaultValue=null;
                    devices.forEach(d=>{
                        const option=document.createElement('option');
                        option.value=d.deviceName;

                        option.textContent=d.displayName+(d.isDefault?' [default]':'')+(d.isDefaultRoute?' [active]':'')+(d.ipAddress?' ('+d.ipAddress+')':'');

                        const details=[d.displayName];
                        if(d.ipAddress)details.push(d.ipAddress);
                        if(d.macAddress)details.push(d.macAddress);
                        if(d.isDefaultRoute)details.push('active adapter');
                        if(d.isLoopback)details.push('loopback');
                        option.title=details.join(' \u00b7 ');
                        deviceSelect.appendChild(option);
                        if(d.isCurrent)currentValue=d.deviceName;
                        if(d.isDefault)defaultValue=d.deviceName;
                    });

                    if(previous&&[...deviceSelect.options].some(o=>o.value===previous))
                    {
                        deviceSelect.value=previous;
                    }
                    else if(currentValue)
                    {
                        deviceSelect.value=currentValue;
                    }
                    else if(defaultValue)
                    {
                        deviceSelect.value=defaultValue;
                    }
                    if(devices.length===0&&!data.npcapDetected)
                    {
                        setDeviceStatus('No capture devices found: the Npcap driver is not installed.',true);
                    }
                    else
                    {
                        setDeviceStatus(devices.length?'':'No capture devices found.',!devices.length);
                    }
                })
                .catch(err=>{
                    console.error('Failed to load devices',err);

                    setDeviceStatus('Failed to load devices.',true);
                });
        }

        document.getElementById('setDevice').addEventListener('click',function(){
            const name=deviceSelect.value;
            if(!name)return;
            const button=this;
            button.disabled=true;
            setDeviceStatus('Switching...',false);
            fetch('/api/capture/select',{
                method:'POST',
                headers:{
                    'Content-Type':'application/json',
                    'RequestVerificationToken':document.getElementById('requestVerificationToken').value
                },
                body:JSON.stringify({deviceName:name})
            })
                .then(r=>r.json().catch(()=>({})).then(body=>({ok:r.ok,body})))
                .then(({ok,body})=>{
                    if(!ok)
                    {

                        setDeviceStatus(body&&body.error?body.error:'Failed to switch device.',true);
                        loadDevices();
                        return;
                    }
                    setDeviceStatus('Capturing on '+((body&&body.current)||name),false);
                })
                .catch(err=>{
                    console.error('Failed to switch device',err);
                    setDeviceStatus('Failed to switch device.',true);
                    loadDevices();
                })
                .finally(()=>{button.disabled=false;});
        });

        document.getElementById('refreshDevices').addEventListener('click',loadDevices);
        loadDevices();

        setInterval(loadDevices,30000);
    </script>
}
