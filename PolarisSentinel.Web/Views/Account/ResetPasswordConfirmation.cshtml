@{
    ViewData["Title"] = "Password Reset";
    Layout = "_LoginLayout";
}

@* Reset-success confirmation page *@
<div class="container" style="max-width:480px;">
    <div class="card shadow-sm birder-primary">
        <div class="card-header bg-primary text-white">
            Password Reset
        </div>
        <div class="card-body">
            <p class="text-muted samll">
                Your password has been reset successfully. You can now sign in with your new password.
            </p>
            <a asp-action="Login" class="btn btn-primary btn-sm">Back to Sign In</a>
        </div>
    </div>
</div>
