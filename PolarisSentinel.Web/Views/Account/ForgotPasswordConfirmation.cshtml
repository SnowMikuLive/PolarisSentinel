@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LoginLayout";
}
@* [New FILE] Forgot-password confirmation page: shows the reset link (prototype only) *@
<div class="container" style="max-width:560px;">
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Reset Password
        </div>
        <div class="card-body">
            @* 原型会把链接显示出来，正式环境会发邮件 *@
            @* Note: production would email the link; this prototype shows it on the page *@
            <p class="text-muted small">
                In a production deployment, a reset link would be sent to your registered email.
                Dor this prototype, use the link below.
            </p>
            @if (TempData["ResetLink"] != null)
            {
                @* Success: show the button; hide the link *@
                <div class="alert alert-info text-center">
                    <div class="small mb-3">
                        A reset link has been generated for your account. Click the button below to set a new password
                    </div>
                    <a href="@TempData["ResetLink"]" class="btn btn-primary btn-sm">
                        Reset My Password
                    </a>
                </div>
            }
            else
            {
                @* Failure: show an error (without revealing whether the account exists)*@
                <div class="alert alert-warning small">
                    @TempData["error"]??"No reset link was generated. Please try again."
                </div>
            }

            <a asp-action="Login" class="btn btn-primary btn-sm mt-2">Back to Sign In</a>
        </div>
    </div>
</div>