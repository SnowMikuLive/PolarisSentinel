@model PolarisSentinel.Web.Models.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_LoginLayout";
}

@* New file: Reset-password form page *@
<div class="container" style="max-width: 480px;">
    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Reset Password
        </div>
        <div class="card-body">

            @* Description *@
            <p class="text-muted small">Enter your new password below.</p>

            <form asp-action="ResetPassword" method="post">
                @* Model-level errors *@
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                @* Email and token from the URL, submitted as hidden fields *@
                <input asp-for="Email" type="hidden" />
                <input asp-for="Code" type="hidden" />

                @* New password *@
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password"/>
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                @* Confirm new password *@
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Reset Password</button>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}
