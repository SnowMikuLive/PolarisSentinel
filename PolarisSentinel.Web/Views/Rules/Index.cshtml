@model IReadOnlyList<PolarisSentinel.Core.Models.Rule>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Rules";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary">Rules</h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary">Create New</a>
            <form asp-action="RemoveAll" method="post" onsubmit="return confirm('Remove all managed firewall rules?');">
                <button type="submit" class="btn btn-outline-danger">Remove All</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            Rule List
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Remote Address</th>
                        <th>Action</th>
                        <th>Enabled</th>
                        <th>Policy</th>
                        <th>Alert</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">No rules yet.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.RemoteAddress</td>
                            <td><span class="badge bg-secondary">@item.Action</span></td>
                            <td>
                                @if (item.Enabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.PolicyId))
                                {
                                    <a asp-controller="Policies" asp-action="Details" asp-route-id="@item.PolicyId">@item.PolicyId</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.AlertId))
                                {
                                    <a asp-controller="InferenceResults" asp-action="Details" asp-route-id="@item.AlertId">@item.AlertId</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>@(item.CreatedAt == default ? "-" : SettingsService.Format(item.CreatedAt))</td>
                            <td>@(item.ExpiresAt != null ? SettingsService.Format(item.ExpiresAt.Value) : "-")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-name="@item.Name" class="btn btn-sm btn-outline-primary">Edit</a>
                                <a asp-action="Delete" asp-route-name="@item.Name" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
