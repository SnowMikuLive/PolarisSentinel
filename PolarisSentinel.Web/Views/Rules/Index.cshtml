@model IReadOnlyList<PolarisSentinel.Core.Models.Rule>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Firewall Rules";
}

<div class="container-fluid">
    <h2 class="text-primary">Firewall Rules</h2>
    <p class="text-muted">Rules created by PolarisSentinel or added manually.</p>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>
    <form asp-action="RemoveAll" method="post" onsubmit="return confirm('Remove all managed firewall rules?');">
        <button type="submit" class="btn btn-outline-danger">Remove All</button>
    </form>
</div>

@* Uses GET so filter conditions appear in the URL and can be bookmarked/shared *@
<form asp-action="Index" method="get" class="card shadow-sm border-primary mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">

            @* Free-text search across id, name, addresses, ports, policy and alert *@
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Search</label>
                <input type="search" name="search" value="@ViewBag.Search" class="form-control form-control-sm"
                       placeholder="IP, port, rule id, policy..." />
            </div>

            @* Filter by status *@
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Status</label>
                <select name="status" class="form-select form-select-sm" asp-items="ViewBag.StatusList">
                    <option value="">All</option>
                </select>
            </div>

            @* Filter by protocol *@
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Protocol</label>
                <select name="protocol" class="form-select form-select-sm" asp-items="ViewBag.ProtocolList">
                    <option value="">All</option>
                </select>
            </div>

            @* Filter by action *@
            <div class="col-md-2">
                <label class="form-label small text-muted mb-1">Action</label>
                <select name="action" class="form-select form-select-sm" asp-items="ViewBag.ActionList">
                    <option value="">All</option>
                </select>
            </div>

            @* Sort order *@
            <div class="col-md-1">
                <label class="form-label small text-muted mb-1">Sort</label>
                <select name="sort" class="form-select form-select-sm">
                    <option value="created" selected="@(ViewBag.Sort == "created" || ViewBag.Sort == null)">Newest</option>
                    <option value="expires" selected="@(ViewBag.Sort == "expires")">Expiry</option>
                    <option value="status" selected="@(ViewBag.Sort == "status")">Status</option>
                    <option value="blocked" selected="@(ViewBag.Sort == "blocked")">Blocked</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm">Apply</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </div>
    </div>
</form>

    <div class="card shadow-sm border-primary">
        <div class="card-body p-0">
            @* Add the horizontal scroll container for narrow screens *@
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Rule ID</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Blocked</th>
                        <th>Protocol</th>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Policy</th>
                        <th>Alert</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                <div>No rules match the current filters.</div>
                                <a asp-action="Create" class="btn btn-sm btn-primary mt-2">Create the first rule</a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@FormatEndpoint(item.SourceIp, item.SourcePort)</td>
                                <td>@FormatEndpoint(item.DestinationIp, item.DestinationPort)</td>
                                <td>
                                    @if (item.BlocksAddress)
                                    {
                                        <span class="badge bg-danger">Block @(item.BlocksOutbound ? "outbound" : "inbound") IP @item.BlockedIp</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Block @(item.BlocksOutbound ? "outbound" : "inbound") port @item.BlockedPort</span>
                                    }
                                </td>
                                <td>@PolarisSentinel.Core.Constants.ProtocolNumbers.Name(item.Protocol)</td>
                                <td><span class="badge bg-secondary">@item.Action</span></td>
                                <td>
                                    @if (item.Status == PolarisSentinel.Core.Enums.RuleStatus.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.Status == PolarisSentinel.Core.Enums.RuleStatus.Expired)
                                    {
                                        <span class="badge bg-warning text-dark">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PolicyId))
                                    {
                                        <a asp-controller="Policies" asp-action="Details" asp-route-id="@item.PolicyId">@item.PolicyId</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.AlertId))
                                    {
                                        <a asp-controller="Alerts" asp-action="Details" asp-route-id="@item.AlertId">@item.AlertId</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@TimeFormat.Format(item.CreatedAt)</td>
                                <td>
                                    @if (item.ExpiresAt is { } expires)
                                    {
                                        <div>@TimeFormat.Format(expires)</div>
                                        @* Warn when an active rule is about to lapse, so it is not silently lost. *@
                                        @if (item.Status == PolarisSentinel.Core.Enums.RuleStatus.Active && TimeFormat.IsWithin(expires, TimeSpan.FromMinutes(15)))
                                        {
                                            <span class="badge bg-warning text-dark">expires @TimeFormat.Relative(expires)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@TimeFormat.Relative(expires)</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
            </div>
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count rule(s)
            @if (Context.Request.Query.Count > 0)
            {
                <span class="ms-2 badge bg-info text-dark">Filtered</span>
            }
        </div>
    </div>
</div>

@functions {
    // Render "ip:port", falling back to the bare IP when the port is unknown.
    static string FormatEndpoint(string? ip, int? port)
    {
        string host = string.IsNullOrEmpty(ip) ? "Any" : ip;
        return port > 0 ? $"{host}:{port}" : host;
    }
}
