@model IReadOnlyList<PolarisSentinel.Core.Models.Rule>
@using PolarisSentinel.Web.Service
@{
    ViewData["Title"] = "Firewall Rules";
}

<div class="container-fluid">
    <h2 class="text-primary">Firewall Rules</h2>
    <p class="text-muted">Rules created by PolarisSentinel or added manually.</p>

    @if (TempData["success"] != null)
    {
        <div class="alert alert-success">@TempData["success"]</div>
    }

    <div class="d-flex gap-2 mb-3">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
        <form asp-action="RemoveAll" method="post" onsubmit="return confirm('Remove all managed firewall rules?');">
            <button type="submit" class="btn btn-outline-danger">Remove All</button>
        </form>
    </div>

    <div class="card shadow-sm border-primary">
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Rule ID</th>
                        <th>Source</th>
                        <th>Destination</th>
                        <th>Protocol</th>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Policy</th>
                        <th>Alert</th>
                        <th>Created</th>
                        <th>Expires</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-3">No rules.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td>@FormatEndpoint(item.SourceIp, item.SourcePort)</td>
                                <td>@FormatEndpoint(item.DestinationIp, item.DestinationPort)</td>
                                <td>@ProtocolName(item.Protocol)</td>
                                <td><span class="badge bg-secondary">@item.Action</span></td>
                                <td>
                                    @if (item.Status == PolarisSentinel.Core.Enums.RuleStatus.Active)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (item.Status == PolarisSentinel.Core.Enums.RuleStatus.Expired)
                                    {
                                        <span class="badge bg-warning text-dark">Expired</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.PolicyId))
                                    {
                                        <a asp-controller="Policies" asp-action="Details" asp-route-id="@item.PolicyId">@item.PolicyId</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.AlertId))
                                    {
                                        <a asp-controller="InferenceResults" asp-action="Details" asp-route-id="@item.AlertId">@item.AlertId</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>@TimeFormat.Format(item.CreatedAt)</td>
                                <td>@(item.ExpiresAt != null ? TimeFormat.Format(item.ExpiresAt.Value) : "-")</td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer small text-muted">
            Total: @Model.Count rule(s)
        </div>
    </div>
</div>

@functions {
    // Render "ip:port", falling back to the bare IP when the port is unknown.
    static string FormatEndpoint(string? ip, int? port)
    {
        string host = string.IsNullOrEmpty(ip) ? "Any" : ip;
        return port > 0 ? $"{host}:{port}" : host;
    }

    // Map an IP protocol number to a readable name.
    static string ProtocolName(byte? protocol) => protocol switch
    {
        1 => "ICMP",
        6 => "TCP",
        17 => "UDP",
        0 => "Any",
        null => "Any",
        _ => protocol.Value.ToString()
    };
}
