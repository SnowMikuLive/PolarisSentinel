@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Delete Rule";
}

<div class="container-fluid">
    <h2 class="text-primary">Delete Rule</h2>

    <div class="card shadow-sm border-danger">
        <div class="card-header bg-danger text-white">
            Confirm deletion
        </div>
        <div class="card-body">
            <p>Are you sure you want to remove this firewall rule?</p>

            <dl class="row">
                <dt class="col-sm-3">Rule ID</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Source</dt>
                <dd class="col-sm-9">@Model.SourceIp</dd>

                <dt class="col-sm-3">Action</dt>
                <dd class="col-sm-9">@Model.Action</dd>

                <dt class="col-sm-3">Rule Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
