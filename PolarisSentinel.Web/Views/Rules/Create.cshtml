@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Create Rule";
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var attackTypes = ViewBag.AttackTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var enabledOptions = ViewBag.EnabledOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Create Rule</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            New Rule
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Address Type</label>
                        <select id="cidrMode" name="cidrMode" class="form-select" onchange="toggleCidr()">
                            <option value="single">Single IP</option>
                            <option value="cidr">CIDR range</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="RemoteAddress" class="form-label">Remote Address</label>
                        <input asp-for="RemoteAddress" class="form-control" placeholder="e.g. 203.0.113.10" />
                        <span asp-validation-for="RemoteAddress" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3" id="cidrPrefixGroup" style="display:none;">
                        <label class="form-label">Prefix Length</label>
                        <input type="number" name="cidrPrefix" class="form-control" min="0" max="128" value="24" />
                        <div class="text-muted small mt-1">e.g. 24 for a /24 range.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                        <span asp-validation-for="Action" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AttackType" class="form-label">Attack Type</label>
                        <select asp-for="AttackType" class="form-select" asp-items="attackTypes"></select>
                        <span asp-validation-for="AttackType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Expires In</label>
                        <div class="input-group">
                            <input type="number" name="durationValue" class="form-control" min="1" value="60" />
                            <select name="durationUnit" class="form-select">
                                <option value="minutes">Minutes</option>
                                <option value="hours">Hours</option>
                                <option value="days">Days</option>
                            </select>
                        </div>
                        <div class="text-muted small mt-1">Rule expires this long after creation.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Enabled" class="form-label"></label>
                        <select asp-for="Enabled" class="form-select" asp-items="enabledOptions"></select>
                        <span asp-validation-for="Enabled" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCidr() {
            const mode = document.getElementById('cidrMode').value;
            document.getElementById('cidrPrefixGroup').style.display = mode === 'cidr' ? '' : 'none';
        }
        toggleCidr();
    </script>
}
