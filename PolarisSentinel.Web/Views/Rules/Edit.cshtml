@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Edit Rule";
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Edit Rule</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            @Model.Id
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" name="id" value="@Model.Id" />

                <h6 class="text-secondary mb-3">Traffic 5-tuple</h6>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label asp-for="SourceIp" class="form-label">Source IP</label>
                        <div class="input-group">
                            <select class="form-select ip-mode" data-target="SourceIp" style="max-width: 6rem;">
                                <option value="any" selected="@(string.IsNullOrEmpty(Model.SourceIp))">Any</option>
                                <option value="manual" selected="@(!string.IsNullOrEmpty(Model.SourceIp))">Manual</option>
                            </select>
                            <input asp-for="SourceIp" class="form-control" placeholder="0.0.0.0" />
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="SourcePort" class="form-label">Source Port</label>
                        <div class="input-group">
                            <select class="form-select port-mode" data-target="SourcePort" style="max-width: 6rem;">
                                <option value="any" selected="@(Model.SourcePort == 0)">Any</option>
                                <option value="manual" selected="@(Model.SourcePort != 0)">Manual</option>
                            </select>
                            <input asp-for="SourcePort" class="form-control" type="number" min="0" max="65535" placeholder="0" />
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="DestinationIp" class="form-label">Destination IP</label>
                        <div class="input-group">
                            <select class="form-select ip-mode" data-target="DestinationIp" style="max-width: 6rem;">
                                <option value="any" selected="@(string.IsNullOrEmpty(Model.DestinationIp))">Any</option>
                                <option value="manual" selected="@(!string.IsNullOrEmpty(Model.DestinationIp))">Manual</option>
                            </select>
                            <input asp-for="DestinationIp" class="form-control" placeholder="0.0.0.0" />
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="DestinationPort" class="form-label">Destination Port</label>
                        <div class="input-group">
                            <select class="form-select port-mode" data-target="DestinationPort" style="max-width: 6rem;">
                                <option value="any" selected="@(Model.DestinationPort == 0)">Any</option>
                                <option value="manual" selected="@(Model.DestinationPort != 0)">Manual</option>
                            </select>
                            <input asp-for="DestinationPort" class="form-control" type="number" min="0" max="65535" placeholder="0" />
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label asp-for="Protocol" class="form-label">Protocol</label>
                        <select asp-for="Protocol" class="form-select">
                            <option value="0">Any</option>
                            <option value="1">ICMP</option>
                            <option value="6">TCP</option>
                            <option value="17">UDP</option>
                        </select>
                    </div>
                </div>

                <h6 class="text-secondary mb-3">Rule</h6>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Extend Expiry By</label>
                        <div class="input-group">
                            <input type="number" name="durationValue" class="form-control" min="1" value="60" />
                            <select name="durationUnit" class="form-select">
                                <option value="minutes">Minutes</option>
                                <option value="hours">Hours</option>
                                <option value="days">Days</option>
                            </select>
                        </div>
                        <div class="text-muted small mt-1">New expiry is set to now + this duration.</div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active" selected="@(Model.Status == PolarisSentinel.Core.Enums.RuleStatus.Active)">Active</option>
                            <option value="Inactive" selected="@(Model.Status == PolarisSentinel.Core.Enums.RuleStatus.Inactive)">Inactive</option>
                            <option value="Expired" selected="@(Model.Status == PolarisSentinel.Core.Enums.RuleStatus.Expired)">Expired</option>
                        </select>
                    </div>

                    @* Association ids are read-only: generated by the system. *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Policy ID</label>
                        <input class="form-control" value="@(string.IsNullOrEmpty(Model.PolicyId) ? "-" : Model.PolicyId)" readonly />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Alert ID</label>
                        <input class="form-control" value="@(string.IsNullOrEmpty(Model.AlertId) ? "-" : Model.AlertId)" readonly />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // "Any" clears the paired input (empty IP / 0 port); "Manual" restores editing.
        document.querySelectorAll('.ip-mode, .port-mode').forEach(function (mode) {
            var input = document.getElementById(mode.dataset.target);
            function sync() {
                var any = mode.value === 'any';
                input.readOnly = any;
                input.classList.toggle('bg-light', any);
                if (any) {
                    input.value = '';
                }
            }
            mode.addEventListener('change', sync);
            sync();
        });
    </script>
}
