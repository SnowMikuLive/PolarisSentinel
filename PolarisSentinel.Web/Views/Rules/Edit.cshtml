@model PolarisSentinel.Core.Models.Rule
@{
    ViewData["Title"] = "Edit Rule";
    var actions = ViewBag.Actions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var attackTypes = ViewBag.AttackTypes as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    var enabledOptions = ViewBag.EnabledOptions as Microsoft.AspNetCore.Mvc.Rendering.SelectList;
    // 已是 CIDR 时预填前缀
    // Prefill the prefix when the address is already a CIDR
    var isCidr = Model.RemoteAddress.Contains('/');
    var addressPart = isCidr ? Model.RemoteAddress.Split('/')[0] : Model.RemoteAddress;
    var prefixPart = isCidr ? Model.RemoteAddress.Split('/')[1] : "24";
}

<div class="container-fluid">
    <h2 class="text-primary mb-3">Edit Rule</h2>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            @Model.RemoteAddress
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" name="name" value="@Model.Name" />

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Address Type</label>
                        <select id="cidrMode" name="cidrMode" class="form-select" onchange="toggleCidr()">
                            <option value="single" selected="@(!isCidr)">Single IP</option>
                            <option value="cidr" selected="@isCidr">CIDR range</option>
                        </select>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label asp-for="RemoteAddress" class="form-label">Remote Address</label>
                        <input asp-for="RemoteAddress" class="form-control" value="@addressPart" />
                        <span asp-validation-for="RemoteAddress" class="text-danger"></span>
                    </div>

                    <div class="col-md-4 mb-3" id="cidrPrefixGroup">
                        <label class="form-label">Prefix Length</label>
                        <input type="number" name="cidrPrefix" class="form-control" min="0" max="128" value="@prefixPart" />
                        <div class="text-muted small mt-1">e.g. 24 for a /24 range.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Action" class="form-label"></label>
                        <select asp-for="Action" class="form-select" asp-items="actions"></select>
                        <span asp-validation-for="Action" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AttackType" class="form-label">Attack Type</label>
                        <select asp-for="AttackType" class="form-select" asp-items="attackTypes"></select>
                        <span asp-validation-for="AttackType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Extend Expiry By</label>
                        <div class="input-group">
                            <input type="number" name="durationValue" class="form-control" min="1" value="60" />
                            <select name="durationUnit" class="form-select">
                                <option value="minutes">Minutes</option>
                                <option value="hours">Hours</option>
                                <option value="days">Days</option>
                            </select>
                        </div>
                        <div class="text-muted small mt-1">New expiry is set to now + this duration.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Enabled" class="form-label"></label>
                        <select asp-for="Enabled" class="form-select" asp-items="enabledOptions"></select>
                        <span asp-validation-for="Enabled" class="text-danger"></span>
                    </div>

                    @* 关联信息只读：由系统生成，不可编辑 *@
                    @* Association ids are read-only: generated by the system *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Policy ID</label>
                        <input class="form-control" value="@(string.IsNullOrEmpty(Model.PolicyId) ? "-" : Model.PolicyId)" readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Alert ID</label>
                        <input class="form-control" value="@(string.IsNullOrEmpty(Model.AlertId) ? "-" : Model.AlertId)" readonly />
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleCidr() {
            const mode = document.getElementById('cidrMode').value;
            document.getElementById('cidrPrefixGroup').style.display = mode === 'cidr' ? '' : 'none';
        }
        toggleCidr();
    </script>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
