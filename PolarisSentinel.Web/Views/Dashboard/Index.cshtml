@{
    ViewData["Title"] = "Dashboard";
    var combinations = PolarisSentinel.Core.Constants.ModelCombinations.All;
}

<div class="container-fluid">
    <h2 class="text-primary">Dashboard</h2>

    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-captured">0</div>
                    <div class="text-muted">Captured Flows</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-alerts">0</div>
                    <div class="text-muted">Alerts</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-rules">0</div>
                    <div class="text-muted">Active Rules</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body">
                    <label for="modelCombination" class="form-label text-muted small">Active AI Model</label>
                    <div class="input-group input-group-sm">
                        <select id="modelCombination" class="form-select form-select-sm">
                            @foreach (var item in combinations)
                            {
                                <option value="@item">@PolarisSentinel.Core.Constants.ModelCombinations.DisplayName(item)</option>
                            }
                        </select>
                        <button type="button" class="btn btn-info" id="btnSetModel">Set</button>
                    </div>
                    <div id="modelStatus" class="small mt-1 text-muted"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-secondary shadow-sm h-100">
                <div class="card-body">
                    <label for="dryRunSelect" class="form-label text-muted small">Firewall Enforcement</label>
                    <div class="input-group input-group-sm">
                        <select id="dryRunSelect" class="form-select form-select-sm">
                            <option value="false">Enforce (block traffic)</option>
                            <option value="true">Dry-run (record only)</option>
                        </select>
                        <button type="button" class="btn btn-secondary" id="btnSetDryRun">Set</button>
                    </div>
                    <div id="dryRunStatus" class="small mt-1 text-muted"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-warning shadow-sm h-100">
                <div class="card-body">
                    <label for="heuristicSelect" class="form-label text-muted small">Heuristic Detection</label>
                    <div class="input-group input-group-sm">
                        <select id="heuristicSelect" class="form-select form-select-sm">
                            <option value="true">Enabled (filter, then AI)</option>
                            <option value="false">Disabled (AI only)</option>
                        </select>
                        <button type="button" class="btn btn-warning" id="btnSetHeuristic">Set</button>
                    </div>
                    <div id="heuristicStatus" class="small mt-1 text-muted"></div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body">
                    <label for="deviceSelect" class="form-label text-muted small">Capture Device</label>
                    <div class="input-group input-group-sm">
                        <select id="deviceSelect" class="form-select form-select-sm"></select>
                        <button type="button" class="btn btn-outline-secondary" id="btnRefreshDevices" title="Reload the device list">&#8635;</button>
                        <button type="button" class="btn btn-success" id="btnSetDevice">Set</button>
                    </div>
                    <div id="deviceStatus" class="small mt-1 text-muted"></div>
                </div>
            </div>
        </div>
    </div>

    <div id="dryRunBanner" class="alert alert-danger d-none mt-3 mb-0" role="alert">
        <strong>&#9888; Enforcement disabled (dry-run).</strong>
        Detections are recorded but <u>no traffic is actually blocked</u>.
        <span id="dryRunReason" class="ms-1"></span>
    </div>

    <div class="row mt-4 g-3">
        <div class="col-md-7">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Traffic Classification
                </div>
                <div class="card-body">

                    <div style="position: relative; height: 240px;">
                        <canvas id="verdictChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Traffic Data
                </div>
                <div class="card-body">
                    <label for="trafficSource" class="form-label">Chart data</label>
                    <select id="trafficSource" class="form-select form-select-sm mb-2">
                        <option value="live">Live traffic</option>
                        <option value="test">Test sample</option>
                    </select>
                    <p id="trafficSourceNote" class="text-muted small" aria-live="polite"></p>
                    <div style="position: relative; height: 240px;">
                        <canvas id="trafficChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary mt-3">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Live Traffic (last 24 hours)</span>
            <span class="d-flex align-items-center gap-3">
                <span class="small" id="liveCount">0 record(s)</span>
                <a asp-controller="Dashboard" asp-action="ExportLiveTraffic" class="btn btn-sm btn-light">Export CSV</a>
                <form asp-action="RemoveAllLiveTraffic" method="post" class="d-inline"
                      onsubmit="return confirm('Remove all live traffic history? This deletes the persisted records for the current window.');">
                    <button type="submit" class="btn btn-sm btn-outline-light">Remove All</button>
                </form>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive" style="max-height: 360px; overflow-y: auto;">
                <table class="table table-sm table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Time</th>
                            <th>Verdict</th>
                            <th>Source</th>
                            <th>Destination</th>
                            <th>Attack Type</th>
                            <th>Confidence</th>
                            <th>Action</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody id="liveBody">
                        <tr><td colspan="8" class="text-center text-muted py-3">No traffic yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.js/chart.umd.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/polaris-hub.js"></script>
    <script>
        if (typeof Chart === 'undefined') {
            window.Chart = function () { return { data: { datasets: [{ data: [] }, { data: [] }] }, options: {}, update: function () { } }; };
            window.Chart.register = function () { };
            window.ChartDataLabels = {};
        }

        const verdictChart = new Chart(document.getElementById('verdictChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: ['Normal', 'Suspicious', 'Malicious', 'Blocked'],
                datasets: [{
                    label: 'Flows',
                    data: [0, 0, 0, 0],
                    backgroundColor: ['#198754', '#ffc107', '#dc3545', '#6c757d']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
            }
        });

        const trafficSource = document.getElementById('trafficSource');
        const trafficChart = new Chart(document.getElementById('trafficChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Normal traffic (flows per minute)',
                    data: [],
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(37,99,235,0.1)',
                    fill: true,
                    tension: 0.3
                }, {

                    label: 'Blocked traffic (flows per minute)',
                    data: [],
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220,53,69,0.12)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: true } },
                scales: {
                    x: { title: { display: true, text: 'Local time' } },
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        const testNormalRates = [20, 25, 22, 30, 28, 35, 120, 300, 550, 800,
            650, 450, 200, 80, 35, 25, 22, 20, 24, 21];
        const testBlockedRates = [0, 0, 0, 0, 0, 0, 0, 0, 0, 140,
            260, 380, 300, 180, 60, 0, 0, 0, 0, 0];
        const testTimes = testNormalRates.map((_, i) => i * 5);
        let liveTimes = [];
        let liveNormal = [];
        let liveBlocked = [];

        function showTrafficChart() {
            const isTest = trafficSource.value === 'test';
            trafficChart.data.labels = (isTest ? testTimes : liveTimes).slice();
            trafficChart.data.datasets[0].data = (isTest ? testNormalRates : liveNormal).slice();
            trafficChart.data.datasets[1].data = (isTest ? testBlockedRates : liveBlocked).slice();
            trafficChart.options.scales.x.title.text = isTest ? 'Elapsed time (seconds)' : 'Local time';
            document.getElementById('trafficSourceNote').textContent = isTest
                ? 'Fixed sample data at 5-second intervals. Dashboard counters and alerts continue to show live data.'
                : (liveTimes.length ? 'Persisted live traffic for today.' : 'Waiting for live traffic.');
            trafficChart.update();
        }

        trafficSource.addEventListener('change', showTrafficChart);

        function loadTrafficSeries() {
            return fetch('/api/detections/traffic-series')
                .then(r => r.json())
                .then(data => {
                    const points = data.points || [];
                    liveTimes = points.map(p => p.time);
                    liveNormal = points.map(p => p.normal);
                    liveBlocked = points.map(p => p.blocked);
                    if (trafficSource.value === 'live') showTrafficChart();
                })
                .catch(err => console.error('Failed to fetch traffic series', err));
        }

        function applyState(state) {
            document.getElementById('c-captured').textContent = state.capturedFlows;
            document.getElementById('c-alerts').textContent = state.alerts;

            document.getElementById('c-rules').textContent = state.activeRules;
            verdictChart.data.datasets[0].data = [state.normal, state.suspicious, state.malicious, state.blocked];
            verdictChart.update();
            renderLive(state.recent);
        }

        function renderLive(records) {
            const body = document.getElementById('liveBody');
            const list = records || [];
            document.getElementById('liveCount').textContent = list.length + ' record(s)';

            if (list.length === 0) {
                body.innerHTML = '<tr><td colspan="8" class="text-center text-muted py-3">No traffic yet.</td></tr>';
                return;
            }

            body.innerHTML = list.map(function (d) {
                const badge = d.verdict === 'Malicious' ? 'bg-danger'
                    : d.verdict === 'Suspicious' ? 'bg-warning text-dark'
                    : d.verdict === 'Blocked' ? 'bg-secondary' : 'bg-success';
                const confidence = d.confidenceScore == null ? 'N/A' : Number(d.confidenceScore).toFixed(3);
                const source = d.sourceIp ? (d.sourceIp + (d.sourcePort ? ':' + d.sourcePort : '')) : '-';
                const destination = d.destinationIp ? (d.destinationIp + (d.destinationPort ? ':' + d.destinationPort : '')) : '-';

                const reason = d.decisionText || d.reason || '-';
                return '<tr>' +
                    '<td class="text-nowrap">' + d.createdAt + '</td>' +
                    '<td class="text-nowrap"><span class="badge ' + badge + '">' + d.verdict + '</span></td>' +
                    '<td>' + source + '</td>' +
                    '<td>' + destination + '</td>' +
                    '<td>' + d.attackType + '</td>' +
                    '<td>' + confidence + '</td>' +
                    '<td>' + d.action + '</td>' +
                    '<td class="small text-muted"><span class="cell-clamp">' + reason + '</span></td>' +
                    '</tr>';
            }).join('');
        }

        fetch('/api/detections/state')
            .then(r => r.json())
            .then(applyState)
            .catch(err => console.error('Failed to fetch state', err));

        loadTrafficSeries();
        showTrafficChart();

        const modelSelect = document.getElementById('modelCombination');
        const modelStatus = document.getElementById('modelStatus');
        const dryRunSelect = document.getElementById('dryRunSelect');
        const dryRunStatus = document.getElementById('dryRunStatus');
        const heuristicSelect = document.getElementById('heuristicSelect');
        const heuristicStatus = document.getElementById('heuristicStatus');

        function applyDryRun(dryRun, reason) {
            dryRunSelect.value = dryRun ? 'true' : 'false';
            dryRunStatus.textContent = dryRun ? 'Dry-run (not blocking)' : 'Enforcing';
            dryRunStatus.className = 'small mt-1 ' + (dryRun ? 'text-danger' : 'text-success');

            const banner = document.getElementById('dryRunBanner');
            if (dryRun) {
                document.getElementById('dryRunReason').textContent = reason ? '(' + reason + ')' : '';
                banner.classList.remove('d-none');
            } else {
                banner.classList.add('d-none');
            }
        }

        function applyHeuristic(enabled) {
            heuristicSelect.value = enabled ? 'true' : 'false';
            heuristicStatus.textContent = enabled ? 'Filtering before AI' : 'AI only (no pre-filter)';
            heuristicStatus.className = 'small mt-1 ' + (enabled ? 'text-success' : 'text-danger');
        }

        fetch('/api/dashboard/info')
            .then(r => r.json())
            .then(info => {
                document.getElementById('c-rules').textContent = info.activeRules;

                modelSelect.value = info.activeModel;
                modelStatus.textContent = 'Active: ' + info.activeModelDisplay;

                applyDryRun(info.dryRun, info.dryRunReason);

                applyHeuristic(info.heuristicEnabled);
            })
            .catch(err => console.error('Failed to fetch dashboard info', err));

        document.getElementById('btnSetDryRun').addEventListener('click', function () {
            const dryRun = dryRunSelect.value === 'true';

            applyDryRun(dryRun, null);

            fetch('/api/dashboard/dryrun', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('requestVerificationToken').value
                },
                body: JSON.stringify({ dryRun: dryRun })
            })
                .then(async r => {
                    const data = await r.json();
                    if (!r.ok) { throw new Error(data.error || 'Failed to change enforcement.'); }
                    return data;
                })
                .then(data => {

                    applyDryRun(data.dryRun, data.dryRunReason);
                })
                .catch(err => {
                    dryRunStatus.textContent = err.message;
                    dryRunStatus.className = 'small mt-1 text-danger';
                });
        });

        document.getElementById('btnSetHeuristic').addEventListener('click', function () {
            const enabled = heuristicSelect.value === 'true';

            applyHeuristic(enabled);

            fetch('/api/dashboard/heuristic', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('requestVerificationToken').value
                },
                body: JSON.stringify({ heuristicEnabled: enabled })
            })
                .then(async r => {
                    const data = await r.json();
                    if (!r.ok) { throw new Error(data.error || 'Failed to change heuristic detection.'); }
                    return data;
                })
                .then(data => {
                    applyHeuristic(data.heuristicEnabled);
                })
                .catch(err => {
                    heuristicStatus.textContent = err.message;
                    heuristicStatus.className = 'small mt-1 text-danger';
                });
        });

        document.getElementById('btnSetModel').addEventListener('click', function () {
            const selectedText = modelSelect.options[modelSelect.selectedIndex].text;
            const selectedValue = modelSelect.value;

            modelStatus.textContent = 'Active: ' + selectedText;
            modelStatus.className = 'small mt-1 text-success';

            fetch('/api/dashboard/model', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('requestVerificationToken').value
                },
                body: JSON.stringify({ modelCombination: selectedValue })
            })
                .then(async r => {
                    const data = await r.json();
                    if (!r.ok) { throw new Error(data.error || 'Failed to change model.'); }
                    return data;
                })
                .then(data => {
                    modelStatus.textContent = 'Active: ' + data.activeModelDisplay;
                    modelStatus.className = 'small mt-1 text-success';
                })
                .catch(err => {
                    modelStatus.textContent = err.message;
                    modelStatus.className = 'small mt-1 text-danger';
                });
        });

        const deviceSelect = document.getElementById('deviceSelect');
        const deviceStatus = document.getElementById('deviceStatus');

        function setDeviceStatus(text, isError) {
            deviceStatus.textContent = text || '';
            deviceStatus.className = 'small mt-1 ' + (isError ? 'text-danger' : 'text-success');
        }

        function loadDevices() {
            return fetch('/api/capture/devices')
                .then(async r => {
                    if (!r.ok) { throw new Error('HTTP ' + r.status); }
                    return r.json();
                })
                .then(data => {
                    const devices = data.devices || [];
                    const previous = deviceSelect.value;
                    deviceSelect.innerHTML = '';

                    let currentValue = null;
                    let defaultValue = null;

                    devices.forEach(d => {
                        const option = document.createElement('option');
                        option.value = d.deviceName;
                        option.textContent = d.displayName
                            + (d.ipAddress ? ' (' + d.ipAddress + ')' : '')
                            + (d.isDefaultRoute ? ' [active]' : '')
                            + (d.isLoopback ? ' [loopback]' : '');

                        const details = [d.displayName];
                        if (d.ipAddress) details.push(d.ipAddress);
                        if (d.macAddress) details.push(d.macAddress);
                        if (d.isDefaultRoute) details.push('active adapter');
                        if (d.isLoopback) details.push('loopback');
                        option.title = details.join(' \u00b7 ');

                        deviceSelect.appendChild(option);
                        if (d.isCurrent) currentValue = d.deviceName;
                        if (d.isDefault) defaultValue = d.deviceName;
                    });

                    if (previous && [...deviceSelect.options].some(o => o.value === previous)) {
                        deviceSelect.value = previous;
                    } else if (currentValue) {
                        deviceSelect.value = currentValue;
                    } else if (defaultValue) {
                        deviceSelect.value = defaultValue;
                    }

                    if (devices.length === 0) {
                        setDeviceStatus(data.npcapDetected === false
                            ? 'No devices: the Npcap driver is not installed.'
                            : 'No capture devices found.', true);
                    } else {
                        setDeviceStatus(devices.length + ' device(s); capturing on '
                            + (currentValue || defaultValue || devices[0].deviceName), false);
                    }
                })
                .catch(err => {
                    console.error('Failed to load capture devices', err);
                    setDeviceStatus('Failed to load devices (reload the page).', true);
                });
        }

        document.getElementById('btnRefreshDevices').addEventListener('click', loadDevices);

        document.getElementById('btnSetDevice').addEventListener('click', function () {
            const name = deviceSelect.value;
            if (!name) { setDeviceStatus('No device selected.', true); return; }

            setDeviceStatus('Switching...', false);

            fetch('/api/capture/select', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.getElementById('requestVerificationToken').value
                },
                body: JSON.stringify({ deviceName: name })
            })
                .then(async r => {
                    const data = await r.json();
                    if (!r.ok) { throw new Error(data.error || 'Failed to switch device.'); }
                    return data;
                })
                .then(data => {
                    setDeviceStatus('Capturing on ' + (data.current || name), false);
                    loadDevices();
                })
                .catch(err => {
                    setDeviceStatus(err.message, true);
                    loadDevices();
                });
        });

        loadDevices();

        let seriesTimer = null;
        polarisHub.on('ReceivePolicyDecision', () => {
            fetch('/api/detections/state').then(r => r.json()).then(applyState)
                .catch(err => console.error(err));

            if (seriesTimer === null) {
                seriesTimer = setTimeout(() => {
                    seriesTimer = null;
                    loadTrafficSeries();
                }, 3000);
            }
        });

        polarisHub.start();
    </script>
}
