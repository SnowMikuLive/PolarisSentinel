@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <h2 class="text-primary">Dashboard</h2>

    @* Four cards on the top now show the overview of system, all driven by SignalR *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card text-center border-primary shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold" id="c-live-traffic">0</div>
                    <div class="text-muted">Live Traffic (Kpps)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-info shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-info" id="c-active-flows">0</div>
                    <div class="text-muted">Active Flows</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-warning shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-warning" id="c-alerts">0</div>
                    <div class="text-muted">Alerts (Cumulative)</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card text-center border-danger shadow-sm">
                <div class="card-body">
                    <div class="fs-2 fw-bold text-danger" id="c-blocks">0</div>
                    <div class="text-muted">Blocks (Cumulative)</div>
                </div>
            </div>
        </div>
    </div>

    @* 测试和实时流量共用图表 / Shared test and live traffic chart *@
    <div class="row mt-4 g-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-header bg-primary text-white">
                    Traffic Trend
                </div>
                <div class="card-body">
                    <label for="trafficSource" class="form-label">Chart data</label>
                    <select id="trafficSource" class="form-select form-select-sm mb-2">
                        <option value="live">Live traffic</option>
                        <option value="test">Test sample</option>
                    </select>
                    <p id="trafficSourceNote" class="text-muted small" aria-live="polite"></p>
                    <div style="height: 220px">
                        <canvas id="trafficChart" aria-label="Traffic trend in packets per second" role="img"></canvas>
                    </div>
                </div>   
            </div>
        </div>

        @* Right: AI Inference Results (latest 8 policy decisions) *@
        <div class="col-md-6"> 
             <div class="card shadow-sm border-primary h-100"> 
                <div class="card-header bg-primary text-white">
                    AI Inference Results
                </div>
                <div class="card-body p-0">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Time</th>
                                <th>Type</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        @* id="aiResultBody" filled by SignalR *@
                        <tbody id="aiResultBody">
                        </tbody>
                    </table>
                </div> 
             </div>
         </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script>
        const MAX_ROWS=8;
        const ctx = document.getElementById('trafficChart').getContext('2d');
        const trafficChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Packets per second',
                    data: [],
                    borderColor: '#2563EB',
                    backgroundColor: 'rgba(40, 100, 235, 0.1)',
                    fill: true,
                    tension: 0.3
                }]
            },
            options: {
                responsive:true,
                maintainAspectRatio:false,
                scales: {
                    y: { 
                        beginAtZero: true,
                        title: { display: true, text: 'Packets per second (pps)' },
                        grid:{color:'rgba(37,99,235,0.1)'},
                        ticks:{color:'#2563EB'}
                        },
                    x: {
                        title: { display: true, text: 'Local time' },
                        grid:{color:'rgba(37,99,235,0.1)'},
                        ticks:{color:'#2563EB'}
                        }
                }
            }
        });

        // 固定样例仅用于图表展示，不发送数据包。
        // Fixed samples demonstrate the chart without sending packets.
        const testRates = [20, 25, 22, 30, 28, 35, 120, 300, 550, 800,
                           650, 450, 200, 80, 35, 25, 22, 20, 24, 21];
        const testTimes = testRates.map((_, i) => i * 5);
        const liveRates = [];
        const liveTimes = [];
        const trafficSource = document.getElementById('trafficSource');

        function showTrafficChart() {
            const isTest = trafficSource.value === 'test';
            trafficChart.data.labels = (isTest ? testTimes : liveTimes).slice();
            trafficChart.data.datasets[0].data = (isTest ? testRates : liveRates).slice();
            trafficChart.data.datasets[0].label = isTest ? 'Test sample (pps)' : 'Live traffic (pps)';
            trafficChart.options.scales.x.title.text = isTest ? 'Elapsed time (seconds)' : 'Local time';
            document.getElementById('trafficSourceNote').textContent = isTest
                ? 'Fixed sample data, 5-second intervals. Cards and alerts still show live data.'
                : (liveTimes.length ? 'Live capture summaries, latest 20 points.' : 'Waiting for live capture summaries.');
            trafficChart.update();
        }
        trafficSource.addEventListener('change', showTrafficChart);
        showTrafficChart();

        //local counters for SignalR updates
        let cumulativeAlerts=0;
        let cumulativeBlocks=0;

        //add: Fetch state from API on load
        fetch('/api/detections/state')
            .then(r=>r.json())
            .then(state=>{
                //Restore cumulative counters
                cumulativeAlerts=state.monitor+state.block;
                cumulativeBlocks=state.block;
                document.getElementById('c-alerts').textContent=cumulativeAlerts;
                document.getElementById('c-blocks').textContent=cumulativeBlocks;


                //Restore AI results table (non-benign only, newest first, max 8)
                const nonBenign=state.recent;//.filter(d=>d.attackType !=='Benign');

                for (let i=Math.min(nonBenign.length, MAX_ROWS)-1;i>=0;i--)
                {
                    addAiResultRow(nonBenign[i]);
                }
        })
        .catch(err=>console.error('Failed to fetch state',err));

        // Connect the SignalR
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/trafficHub")
            .withAutomaticReconnect()
            .build();
       
        // Receive live traffic summary: update chart + two live cards
        connection.on("ReceiveLiveTrafficSummary", (summary) => {
            // 测试图显示期间也保留实时数据，切回时不会混入样例。
            // Keep live data separate while displaying the test sample.
            liveTimes.push(new Date(summary.timestamp).toLocaleTimeString());
            liveRates.push(summary.packetsPerSecond);
            if (liveTimes.length > 20) {
                liveTimes.shift();
                liveRates.shift();
            }
            if (trafficSource.value === 'live') showTrafficChart();

            // Live Traffic card show Kpps
            document.getElementById('c-live-traffic').textContent=(summary.packetsPerSecond/1000).toFixed(1);
            
            // Active Flows card
            document.getElementById('c-active-flows').textContent=summary.activeFlowCount;
        });

        //Receive policy decisions:accumulate Alerts/Blocks + add to AI results
        connection.on('ReceivePolicyDecision',(d)=>{
            if(d.attackType==='Benign')return;

            cumulativeAlerts++;
            if(d.action==='Block')cumulativeBlocks++;

            document.getElementById('c-alerts').textContent=cumulativeAlerts;
            document.getElementById('c-blocks').textContent=cumulativeBlocks;

            addAiResultRow(d);
        });

        // AI results function shows
        function addAiResultRow(d)
        {
            const body=document.getElementById('aiResultBody');
            const row=body.insertRow(0);

            //color depende on the policy action
            row.className=d.action==='Block'?'table-danger':
                          d.action==='Monitor'?'table-warning':'';

            // the budge which can distinguish the IF and RF
            const badge=d.action==='Block'?
                            '<span class="badge bg-danger">BLOCK</span>':
                            (d.action==='Monitor' && d.attackType==='Unknown_Anomaly') ?
                            '<span class="badge bg-warning text-dark">IF</span>':
                            '<span class="badge bg-warning text-dark">RF</span>';
            row.innerHTML=
                    `<td>${d.decidedAt}</td>`+
                    `<td>${d.attackType}</td>`+
                    `<td>${badge}</td>`;

            //Keep max 8 rows
            while (body.rows.length>MAX_ROWS)body.deleteRow(MAX_ROWS);
        }

        connection.start().catch(err => console.error(err.toString()));
    </script>
}