@{
    ViewData["Title"] = "Attack Simulation";
}

<div class="container-fluid">
    <h2 class="text-primary">Attack Simulation</h2>
    <p class="text-muted">Injects a synthetic attack through the real pipeline: detection &rarr; policy decision &rarr; firewall rule.</p>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            Simulate Attack
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label for="attackType" class="form-label">Attack Type</label>
                    <select id="attackType" class="form-select">
                        <option value="DoS">DoS</option>
                        <option value="PortScan">PortScan</option>
                        <option value="BruteForce">BruteForce</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="sourceIp" class="form-label">Source IP</label>
                    <input id="sourceIp" class="form-control" value="255.0.111.222" />
                </div>
                <div class="col-md-2">
                    <label for="protocol" class="form-label">Protocol</label>
                    <select id="protocol" class="form-select">
                        <option value="6">TCP</option>
                        <option value="17">UDP</option>
                        <option value="1">ICMP</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="destinationPort" class="form-label">Dest Port</label>
                    <input id="destinationPort" class="form-control" type="number" value="80" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button id="injectBtn" class="btn btn-danger w-100">Launch Attack</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary mb-3">
        <div class="card-header bg-primary text-white">
            Pipeline Result
        </div>
        <div class="card-body">
            <div id="resultPlaceholder" class="text-muted">No attack simulated yet.</div>
            <div id="resultBody" class="d-none">
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <div class="card text-center border-secondary h-100">
                            <div class="card-body">
                                <div class="fs-5 fw-bold" id="r-detect">-</div>
                                <div class="small" id="r-source">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-secondary h-100">
                            <div class="card-body">
                                <div class="fs-5 fw-bold" id="r-policy">-</div>
                                <div class="small" id="r-reason">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-secondary h-100">
                            <div class="card-body">
                                <div class="fs-5 fw-bold" id="r-action">-</div>
                                <div class="small" id="r-alertid">-</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center border-secondary h-100">
                            <div class="card-body">
                                <div class="fs-5 fw-bold" id="r-rule">-</div>
                                <div class="small" id="r-ruleid">-</div>
                            </div>
                        </div>
                    </div>
                </div>
                <pre id="r-json" class="bg-light p-3 rounded small mb-0"></pre>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-primary">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <span>Simulated Attacks</span>
            <a asp-controller="Rules" asp-action="Index" class="btn btn-sm btn-light">View Firewall Rules</a>
        </div>
        <div class="card-body p-0">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Alert ID</th>
                        <th>Attack</th>
                        <th>Source</th>
                        <th>Action</th>
                        <th>Reason</th>
                        <th>Rule</th>
                    </tr>
                </thead>
                <tbody id="historyBody">
                    <tr><td colspan="6" class="text-center text-muted py-3">No attacks simulated.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var results = [];

        function renderHistory() {
            var body = document.getElementById('historyBody');
            if (results.length === 0) {
                body.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-3">No attacks simulated.</td></tr>';
                return;
            }
            body.innerHTML = results.map(function (r) {
                var cls = r.action === 'Block' ? 'table-danger' : 'table-warning';
                return '<tr class="' + cls + '">' +
                    '<td class="fw-bold">' + r.alertId + '</td>' +
                    '<td>' + r.attackType + '</td>' +
                    '<td>' + r.sourceIp + '</td>' +
                    '<td><span class="badge bg-' + (r.action === 'Block' ? 'danger' : 'warning text-dark') + '">' + r.action + '</span></td>' +
                    '<td>' + r.reason + '</td>' +
                    '<td class="small">' + (r.ruleName || '-') + '</td>' +
                    '</tr>';
            }).join('');
        }

        document.getElementById('injectBtn').addEventListener('click', function () {
            var btn = this;
            btn.disabled = true;
            btn.textContent = 'Running...';

            var payload = {
                attackType: document.getElementById('attackType').value,
                sourceIp: document.getElementById('sourceIp').value,
                protocol: parseInt(document.getElementById('protocol').value, 10),
                destinationPort: parseInt(document.getElementById('destinationPort').value, 10)
            };

            fetch('/api/demo/inject', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
                .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
                .then(function (res) {
                    if (!res.ok) {
                        alert('Failed: ' + (res.data.error || 'unknown error'));
                        return;
                    }
                    var d = res.data;
                    document.getElementById('resultPlaceholder').classList.add('d-none');
                    document.getElementById('resultBody').classList.remove('d-none');
                    document.getElementById('r-detect').textContent = d.attackType;
                    document.getElementById('r-source').textContent = d.source + ' / ' + d.sourceIp;
                    document.getElementById('r-policy').textContent = d.policyId;
                    document.getElementById('r-reason').textContent = d.reason;
                    document.getElementById('r-action').textContent = d.action;
                    document.getElementById('r-alertid').textContent = d.alertId;
                    document.getElementById('r-rule').textContent = d.ruleName ? 'Created' : 'None';
                    document.getElementById('r-ruleid').textContent = d.ruleName || '-';
                    document.getElementById('r-json').textContent = JSON.stringify(d, null, 2);

                    results.unshift(d);
                    renderHistory();
                })
                .catch(function (err) { alert('Request failed: ' + err); })
                .finally(function () {
                    btn.disabled = false;
                    btn.textContent = 'Launch Attack';
                });
        });
    </script>
}
