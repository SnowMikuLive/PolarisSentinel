@{
    ViewData["Title"] = "Settings";
}
<div class="container-fluid">
    @* Page header *@
    <div class="mb-4">
        <h2 class="text-primary mb-0">Settings</h2>
        <small class="text-muted">System configuration and account management</small>
    </div>
    @* Background Service *@
    <div class="card shadow-sm border-primary mb-3">
        <div class="card-body">
            <h6 class="fw-bold text-primary mb-2">Background Service</h6>
            <strong id="serviceState" class="me-3">Loading...</strong>
         </div>
    </div>

    @* Account Management *@
    <div class="card shadow-sm border-primary mb-3">
        <div class="card-body">
            <h6 class="fw-bold text-primary mb-3">Account Management</h6>
            <div class="row g-4">

                <div class="col-md-7 offset-md-5">
                    <h6 class="fw-bold mb-3">Change Password</h6>
                    <p class="text-muted small mb-3">
                        You will be redirected to a secure page to update your password.
                    </p>
                    <a asp-controller="Account" asp-action="ChangePassword" class="btn btn-primary btn-sm">
                        Change Password
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script>
        // Reuses the existing /api/capture/devices: current!=null means Running, otherwise Stopped.
        function renderServiceStatus(isRunning) {
            const state = document.getElementById('serviceState');
            state.className = isRunning ? 'text-success' : 'text-danger';
            state.textContent = isRunning ? 'Running' : 'Stopped';
        }

        function handleFetchError(err) {
            console.error('Failed to fetch capture status', err);
            const state = document.getElementById('serviceState');
            state.className = 'text-muted';
            state.textContent = 'Unknown';
        }

        function refreshServiceStatus() {
            fetch('/api/capture/devices')
                .then(response => response.json())
                .then(data => renderServiceStatus(!!data.current))
                .catch(handleFetchError);
        }

        refreshServiceStatus();
        // Poll every 10 seconds.
        setInterval(refreshServiceStatus, 10000);
        </script>
}