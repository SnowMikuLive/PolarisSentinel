{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5180",
  "Dashboard": {
    "Url": "http://localhost:5180"
  },
  "Inference": {
    "ModelPath": "../ml/artifacts/rf_model.onnx",
    "AnomalyModelPath": "../ml/artifacts/if_model.onnx"
  },
  "PolicySettings": {
    "FlowIdleTimeoutMilliseconds": 120000,
    "PreFilterMinPackets": 3,
    "RfConfidenceThreshold": 0.6,
    "AutoBlockConfidenceThreshold": 0.8,
    "IfAnomalyThreshold": -0.150806,
    "BlockDurationMinutes": 60,
    "DecisionCooldownSeconds": 60,
    "Allowlist": []
  },
  "Firewall": {
    "DryRun": true,
    "SweepSeconds": 30
  },
  "Settings": {
    "TimeZoneId": "UTC"
  },
  // 初始管理员账号。密码不写在这里，运行时通过 user-secrets 或环境变量提供：
  // Initial admin account. The password is NOT stored here; supply it at runtime
  // via user-secrets (dev) or the AdminSeed__Password environment variable (prod).
  "AdminSeed": {
    "Enabled": true,
    "UserName": "admin",
    "Email": "admin@polaris.local",
    "Role": "Administrator"
  }
}
