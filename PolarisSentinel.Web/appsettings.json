{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Urls": "http://localhost:5180",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PolarisSentinel;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Dashboard": {
    "Url": "http://localhost:5180"
  },
  "Inference": {
    "ModelPath": "../ml/artifacts/rf_model.onnx",
    "AnomalyModelPath": "../ml/artifacts/if_model.onnx"
  },
  "Evaluation": {
    "DefaultDatasetPath": "../ml/artifacts/cic_demo_dataset.csv"
  },
  "PolicySettings": {
    "FlowIdleTimeoutMilliseconds": 8000,
    "Sensitivity": "High",
    "Allowlist": [],
    "LiveSummaryIntervalSeconds": 5
  },
  "Firewall": {
    "DryRun": false,
    "SweepSeconds": 30
  },

  "AdminSeed": {
    "Enabled": true,
    "UserName": "admin",
    "Email": "admin@polaris.local",
    "Role": "Administrator"
  }
}
